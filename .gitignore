# Dependencies
node_modules/

# Build output (anchored to web/ so they don't catch mirrored theme
# assets that legitimately live under web/public/wp/.../{build,dist}/)
web/dist/
.astro/
.wrangler/

# Environment / secrets (never commit)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example
.dev.vars
.cf.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*

# Caches
.npm
.npm-cache
.eslintcache
*.tsbuildinfo

# OS / editor
.DS_Store
.DS_Store?
._*
Thumbs.db
.vscode/
.idea/
*.swp

# Local-only tooling / config (machine-specific)
.mcp.json
.claude/
.devcontainer/

# Drafts inbox (local only)
web/_drafts/

# Only the per-page <main> content (*.main.html) for not-yet-componentized pages
# is tracked; ignore any other local capture artifacts under _mirror/. (Resource
# articles now live as Markdown in src/content/resources/.)
web/_mirror/*.html
!web/_mirror/*.main.html
web/_mirror/raw.json
