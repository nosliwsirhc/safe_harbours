{
  "name": "safe-harbours-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Safe Harbours website — Astro rebuild",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"public/assets/a11y-overrides.css\" \"src/**/*.astro\"",
    "lint:css:fix": "stylelint --fix \"public/assets/a11y-overrides.css\" \"src/**/*.astro\"",
    "lint": "astro check && eslint . && npm run lint:css",
    "lint:fix": "eslint . --fix && npm run lint:css:fix",
    "analyze:css": "node scripts/analyze-css.mjs",
    "images": "node scripts/images.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.6.0",
    "@astrojs/sitemap": "^3.7.3",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@lexical/html": "^0.45.0",
    "@lexical/link": "^0.45.0",
    "@lexical/rich-text": "^0.45.0",
    "@lexical/utils": "^0.45.0",
    "astro": "^6.4.2",
    "lexical": "^0.45.0"
  },
  "overrides": {
    "undici": "^7.26.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@projectwallace/css-analyzer": "^9.8.2",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "postcss-html": "^1.8.1",
    "purgecss": "^8.0.0",
    "sharp": "^0.34.5",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-high-performance-animation": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
