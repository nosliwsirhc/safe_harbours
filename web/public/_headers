# Cache headers for self-hosted assets. (Cloudflare's default for these was
# max-age=0, must-revalidate — a conditional request on every page load.)
# Uploaded media never changes (stable filenames) → cache hard for a year.
# Theme CSS/JS can change on a re-mirror → cache a day.

/assets/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400
