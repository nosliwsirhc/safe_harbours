# Cloudflare redirects. Syntax: /from  /to  status
#
# The Astro slugs match the old WordPress paths 1:1, and Cloudflare's static-
# asset handler auto-drops trailing slashes (so /about-fostering/ -> /about-fostering
# and /resources/<slug>/ -> /resources/<slug> resolve without rules here).
# These cover common aliases / shortcuts that may be linked externally.
# NOTE: Workers static-asset _redirects only allow RELATIVE URLs, so the
# apex→www (cross-host) redirect can't live here — it's a zone Redirect Rule
# (see docs/go-live.md).

/home/        /                                  301
/contact      /contact-us                        301
/contact/     /contact-us                        301
/complaints   /program-description/complaints     301
/complaints/  /program-description/complaints     301
/blog         /resources                         301
/blog/        /resources                         301
/thank-you    /thank-you-fostering               301
/thank-you/   /thank-you-fostering               301

# Old WordPress asset URLs -> self-hosted /assets/ (preserve indexed/hotlinked
# images + any path the theme JS/CSS resolves at runtime).
/wp-content/uploads/*                  /assets/uploads/:splat     301
/wp-content/themes/safe-harbours/*     /assets/theme/:splat       301
/wp-content/plugins/*                  /assets/plugins/:splat     301
/wp-includes/*                         /assets/includes/:splat    301
# Earlier interim prefix used on the *.workers.dev preview.
/wp/*                                  /assets/:splat             301
