---
// Opt-in cookie consent. Nothing tracks until the visitor clicks Accept; the
// choice is remembered in localStorage. Declining (or doing nothing, or having
// JS off) keeps Consent Mode at its denied default, so no analytics/ads cookies
// load. Returning visitors who accepted get tracking enabled without the banner.
//
// IDs come from /admin/settings (D1). If a GTM container is configured, GTM
// owns GA4/Ads and we only flip the consent state; otherwise we load GA4
// directly here as a fallback so analytics keeps working.
interface Props {
  ga4Id?: string;
  gtmId?: string;
}
const { ga4Id = '', gtmId = '' } = Astro.props;
---
<div class="consent" id="consent" role="region" aria-label="Cookie consent" hidden>
  <p class="consent-text">
    We use Google Analytics to understand how visitors find and use our site. May we turn on
    analytics cookies? You can read more in our <a href="/privacy-policy">Privacy Policy</a>.
  </p>
  <div class="consent-actions">
    <button type="button" class="btn btn-out btn-sm" id="consent-decline">Decline</button>
    <button type="button" class="btn btn-coral btn-sm" id="consent-accept">Accept</button>
  </div>
</div>

<script is:inline define:vars={{ ga4Id, gtmId }}>
  (function () {
    var KEY = 'sh-consent';
    var enabled = false;
    // gtag() is defined in the head (Consent Mode default). Guard anyway.
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    if (!window.gtag) window.gtag = gtag;

    function enable() {
      if (enabled) return;
      enabled = true;
      // Tell GTM + any Consent-Mode tags they may now run.
      window.gtag('consent', 'update', {
        ad_storage: 'granted', ad_user_data: 'granted',
        ad_personalization: 'granted', analytics_storage: 'granted',
      });
      window.dataLayer.push({ event: 'consent_granted' });
      // No GTM container? Load GA4 directly as a fallback.
      if (!gtmId && ga4Id && ga4Id !== 'G-XXXXXXXXXX') {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
        document.head.appendChild(s);
        window.gtag('js', new Date());
        window.gtag('config', ga4Id, { anonymize_ip: true });
      }
    }

    var stored = null;
    try { stored = localStorage.getItem(KEY); } catch (e) {}

    if (stored === 'granted') { enable(); return; }
    if (stored === 'denied') { return; }

    // No choice yet: show the banner.
    var banner = document.getElementById('consent');
    if (!banner) return;
    banner.hidden = false;
    // Next frame so the entrance transition runs.
    requestAnimationFrame(function () { banner.classList.add('show'); });

    function decide(value) {
      try { localStorage.setItem(KEY, value); } catch (e) {}
      banner.classList.remove('show');
      var hide = function () { banner.hidden = true; banner.removeEventListener('transitionend', hide); };
      banner.addEventListener('transitionend', hide);
      // Fallback in case transitionend doesn't fire (reduced motion, etc.).
      setTimeout(hide, 400);
      if (value === 'granted') enable();
    }

    document.getElementById('consent-accept')?.addEventListener('click', function () { decide('granted'); });
    document.getElementById('consent-decline')?.addEventListener('click', function () { decide('denied'); });
  })();
</script>

<style>
  .consent {
    position: fixed;
    left: clamp(12px, 3vw, 24px);
    bottom: clamp(12px, 3vw, 24px);
    z-index: 2000;
    max-width: 26rem;
    background: var(--slate, #484e5e);
    color: var(--on-dark, #e3e7ee);
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: 14px;
    padding: 18px 20px 16px;
    font-family: "Source Sans 3", system-ui, -apple-system, sans-serif;
    box-shadow: 0 14px 40px -12px rgb(13 24 33 / 55%);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1), transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .consent.show {
    opacity: 1;
    transform: translateY(0);
  }

  .consent-text {
    margin: 0 0 14px;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--on-dark, #e3e7ee);
  }

  /* Self-contained button styling so the banner renders identically whether
     or not the global stylesheet is present (it isn't on mirrored pages). */
  .consent .btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 800; border: 1.5px solid transparent; border-radius: 8px;
    cursor: pointer; font-family: inherit; line-height: 1.2; transition: filter 0.2s, background 0.2s, color 0.2s;
  }
  .consent .btn-coral { background: var(--coral-d, #c8453f); color: #fff; }
  .consent .btn-coral:hover { filter: brightness(1.06); }

  .consent-text a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .consent-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
  }

  .consent .btn-sm {
    padding: 8px 18px;
    font-size: 0.9rem;
  }

  /* Keep the decline (ghost) button legible on the dark card. */
  .consent .btn-out {
    color: var(--on-dark, #e3e7ee);
    border-color: rgb(227 231 238 / 45%);
    background: transparent;
  }

  .consent .btn-out:hover {
    background: color-mix(in oklch, white, transparent 88%);
    color: #fff;
  }

  @media (width <= 520px) {
    .consent {
      left: 10px;
      right: 10px;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent {
      transition: opacity 0.2s linear;
      transform: none;
    }
    .consent.show { transform: none; }
  }
</style>
