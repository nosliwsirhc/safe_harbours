---
// Reusable contact form: client-side validation, phone formatting, Cloudflare
// Turnstile, and an inline "morph" success state. Submits to the /api/contact
// Worker route. Used on the homepage and /contact-us.
import { site } from '../data/site';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA'; // test key fallback
---
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<div class="form-card" id="form-card">
  <form class="contact" id="contact-form" novalidate data-phone={site.phone}>
    <h3>Send Us a Message</h3>
    <p class="sub">Fields marked <span class="req" aria-hidden="true">*</span> are required. An email or a phone number is fine - fill in whichever you prefer.</p>
    <div class="frow">
      <div class="field"><label for="f-first">First name <span class="req" aria-hidden="true">*</span></label><input id="f-first" name="first" required aria-required="true" aria-describedby="err-first" /><div class="errmsg" id="err-first" role="alert">Required</div></div>
      <div class="field"><label for="f-last">Last name <span class="opt">(optional)</span></label><input id="f-last" name="last" /></div>
    </div>
    <div class="frow">
      <div class="field"><label for="f-email">Email <span class="opt" id="req-email">(email or phone)</span></label><input id="f-email" name="email" type="email" aria-required="true" aria-describedby="err-email" /><div class="errmsg" id="err-email" role="alert">Enter a valid email</div></div>
      <div class="field"><label for="f-phone">Phone <span class="opt" id="req-phone">(email or phone)</span></label><input id="f-phone" name="phone" type="tel" aria-required="true" aria-describedby="err-phone" /><div class="errmsg" id="err-phone" role="alert">Required</div></div>
    </div>
    <div class="field"><label for="f-role">I am a… <span class="req" aria-hidden="true">*</span></label>
      <select id="f-role" name="role" required aria-required="true" aria-describedby="err-role">
        <option value="">Select one</option>
        <option>Prospective Foster Parent</option>
        <option>Current Foster Family</option>
        <option>Professional / Agency Partner</option>
        <option>Community Supporter</option>
        <option>Something Else</option>
      </select>
      <div class="errmsg" id="err-role" role="alert">Please choose one</div>
    </div>
    <div class="field"><label for="f-msg">Message <span class="req" aria-hidden="true">*</span></label><textarea id="f-msg" name="msg" placeholder="How can we help?" required aria-required="true" aria-describedby="err-msg"></textarea><div class="errmsg" id="err-msg" role="alert">Please add a short message</div></div>
    <div class="cf-turnstile" data-sitekey={siteKey} data-size="flexible"></div>
    <button type="submit" id="submit-btn" class="btn btn-coral" style="width:100%;justify-content:center;padding:15px;margin-top:16px">Submit Message</button>
    <p class="form-error" id="form-error" role="alert"></p>
  </form>
  <div class="form-ok" id="form-ok" role="status" tabindex="-1">
    <svg class="ok-check" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="25"/><path d="M14 27l8 8 16-18"/></svg>
    <h3>Message sent</h3>
    <p>Thanks for reaching out. A real person on our team reads every message and will get back to you within one business day.</p>
    <button type="button" id="send-another" class="btn btn-out">Send another message?</button>
  </div>
</div>

<script>
  import { formatPhoneWithCaret, isValidEmail, isValidPhone } from '../lib/form';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const phoneInput = document.getElementById('f-phone') as HTMLInputElement | null;
    const formError = document.getElementById('form-error') as HTMLElement | null;
    const val = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
    const setErr = (n: string, msg: string) => {
      const field = document.getElementById('f-' + n)?.closest('.field');
      const input = document.getElementById('f-' + n);
      const errEl = document.getElementById('err-' + n);
      if (msg) {
        field?.classList.add('err');
        input?.setAttribute('aria-invalid', 'true');
        if (errEl) errEl.textContent = msg;
      } else {
        field?.classList.remove('err');
        input?.removeAttribute('aria-invalid');
      }
    };
    const showFormError = (m: string) => { if (formError) formError.textContent = m; };
    const clearFormError = () => { if (formError) formError.textContent = ''; };

    const errorsFor = () => {
      const email = val('email'), phone = val('phone');
      const errs: Record<string, string> = {};
      if (!val('first')) errs.first = 'Required';
      if (email && !isValidEmail(email)) errs.email = 'Enter a valid email';
      if (phone && !isValidPhone(phone)) errs.phone = 'Enter a 10-digit phone number';
      if (!email && !phone) { errs.email = 'Enter an email or phone number'; errs.phone = 'Enter an email or phone number'; }
      if (!val('role')) errs.role = 'Please choose one';
      if (!val('msg')) errs.msg = 'Please add a short message';
      return errs;
    };

    const updateContactReq = () => {
      const emailFilled = !!val('email'), phoneFilled = !!val('phone');
      const toggle = (name: string, required: boolean) => {
        const star = document.getElementById('req-' + name);
        if (star) star.style.display = required ? '' : 'none';
        document.getElementById('f-' + name)?.setAttribute('aria-required', required ? 'true' : 'false');
      };
      toggle('email', !phoneFilled);
      toggle('phone', !emailFilled);
    };

    const refresh = () => {
      updateContactReq();
      if (submitBtn) submitBtn.disabled = Object.keys(errorsFor()).length > 0;
    };

    ['first', 'email', 'phone', 'role', 'msg'].forEach((n) => {
      document.getElementById('f-' + n)?.addEventListener('blur', () => setErr(n, errorsFor()[n] || ''));
    });

    form.querySelectorAll('input, select, textarea').forEach((el) =>
      el.addEventListener('input', () => {
        if (el === phoneInput && phoneInput) {
          const pos = phoneInput.selectionStart ?? phoneInput.value.length;
          const { value, caret } = formatPhoneWithCaret(phoneInput.value, pos);
          phoneInput.value = value;
          phoneInput.setSelectionRange(caret, caret);
        }
        setErr((el as HTMLInputElement).name, '');
        clearFormError();
        if ((val('email') && isValidEmail(val('email'))) || (val('phone') && isValidPhone(val('phone')))) { setErr('email', ''); setErr('phone', ''); }
        refresh();
      })
    );

    const card = document.getElementById('form-card');
    const okEl = document.getElementById('form-ok');
    const morph = (swap: () => void) => {
      if (!card) { swap(); return; }
      const startH = card.offsetHeight;
      swap();
      const endH = card.offsetHeight;
      card.style.height = startH + 'px';
      void card.offsetHeight;
      card.style.height = endH + 'px';
      const done = (e: TransitionEvent) => {
        if (e.propertyName !== 'height') return;
        card.style.height = 'auto';
        card.removeEventListener('transitionend', done);
      };
      card.addEventListener('transitionend', done);
    };

    let submitting = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitting) return;
      const errs = errorsFor();
      const order = ['first', 'email', 'phone', 'role', 'msg'];
      if (Object.keys(errs).length) {
        order.forEach((n) => setErr(n, errs[n] || ''));
        document.getElementById('f-' + order.find((n) => errs[n]))?.focus();
        return;
      }
      const token = (form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value || '';
      if (!token) {
        // If the Turnstile widget rendered, ask them to complete it. If it
        // never loaded (blocked/offline), don't leave them stuck - offer a phone.
        const widgetLoaded = !!form.querySelector('.cf-turnstile iframe');
        const phone = form.dataset.phone;
        showFormError(widgetLoaded
          ? 'Please complete the verification below, then submit again.'
          : `Verification could not load. Please refresh the page${phone ? `, or call us at ${phone}` : ''}.`);
        return;
      }

      submitting = true;
      clearFormError();
      const label = submitBtn?.textContent;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ first: val('first'), last: val('last'), email: val('email'), phone: val('phone'), role: val('role'), msg: val('msg'), token }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          // GA4 conversion (only fires if the visitor accepted analytics — gtag is undefined otherwise).
          (window as any).gtag?.('event', 'generate_lead', { form_location: location.pathname });
          morph(() => { form.style.display = 'none'; okEl?.classList.add('show'); });
          okEl?.focus();
        } else {
          showFormError(data.error || 'Something went wrong. Please try again, or call us.');
          (window as any).turnstile?.reset();
        }
      } catch {
        showFormError('We couldn’t reach the server. Please try again, or call us.');
        (window as any).turnstile?.reset();
      } finally {
        submitting = false;
        if (submitBtn) { submitBtn.textContent = label || 'Submit Message'; }
        refresh();
      }
    });

    document.getElementById('send-another')?.addEventListener('click', () => {
      morph(() => {
        okEl?.classList.remove('show');
        form.style.display = '';
        form.reset();
        clearFormError();
        ['first', 'email', 'phone', 'role', 'msg'].forEach((n) => setErr(n, ''));
        (window as any).turnstile?.reset();
        refresh();
      });
      document.getElementById('f-first')?.focus();
    });

    refresh();
  }
</script>
