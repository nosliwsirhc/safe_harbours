---
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Ready to open your home?',
  text = 'Reach out and a member of our team will get back to you within one business day. No pressure, just a conversation.',
} = Astro.props;
---
<section class="pad cta-band">
  <div class="wrap">
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="actions">
      <a class="btn btn-coral" href="/contact-us">Talk to Our Team</a>
      <a class="btn btn-out" href="/become-a-foster-parent">Become a Foster Parent</a>
    </div>
  </div>
</section>
