---
// The site's page-hero, rebuilt as a real component. Markup + classes are copied
// verbatim from the mirror so the self-hosted theme CSS styles it identically —
// only the text + background are now data (props), not frozen HTML. This single
// component backs the hero on every page that has one (7 of them). The
// data-cms-field hooks let the admin update the preview in place.
interface Props {
  lead?: string;
  heading?: string;
  intro?: string;
  bg?: string; // full CSS image-set(...) value
  variant?: string; // extra class on .page-hero (e.g. a landing variant)
}
const { lead = '', heading = '', intro = '', bg = '', variant = '' } = Astro.props;
---
<div class:list={['page-hero', variant]}>
  <div class="grid-container">
    <div class="overlay"></div>
    {bg && <div class="background-image" style={`background-image: ${bg};`}></div>}
    <div class="grid-x">
      <div class="cell medium-9 large-7">
        <div class="content">
          <p class="lead" data-cms-field="lead">{lead}</p>
          <h1 data-cms-field="heading">{heading}</h1>
          <div class="hero-intro" data-cms-field="intro" set:html={intro}></div>
        </div>
      </div>
    </div>
    <svg class="circle-1 show-for-large" xmlns="http://www.w3.org/2000/svg" width="179" height="179" viewBox="0 0 179 179" fill="none">
      <circle cx="89.2938" cy="89.5107" r="87" transform="rotate(-91.5314 89.2938 89.5107)" fill="#DAB527" fill-opacity="0.89"></circle>
    </svg>
    <svg class="circle-2 show-for-large" xmlns="http://www.w3.org/2000/svg" width="112" height="112" viewBox="0 0 112 112" fill="none">
      <circle cx="55.9621" cy="55.937" r="54.5" transform="rotate(-91.5314 55.9621 55.937)" fill="#F9A5A2"></circle>
    </svg>
  </div>
</div>
