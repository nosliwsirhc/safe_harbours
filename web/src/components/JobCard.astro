---
// One opening, as a wide full-width row on the careers board. Links to the SSR
// detail page. (Filename kept; it is the openings row.)
import type { JobPosting } from '../lib/jobs';
interface Props { job: JobPosting }
const { job } = Astro.props;

const location = [job.city, job.region].filter(Boolean).join(', ') || job.home || 'Ontario';
const money = (n: number) => `$${n.toLocaleString('en-CA', { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 })}`;
const unit = job.payBasis === 'Annual' ? '/yr' : '/hr';
const wage = job.wageMin != null && job.wageMax != null && job.wageMax !== job.wageMin
  ? `${money(job.wageMin)}–${money(job.wageMax)}${unit}`
  : job.wageMin != null ? `${money(job.wageMin)}${unit}`
  : job.wageMax != null ? `${money(job.wageMax)}${unit}` : null;
const closesDate = new Date(`${job.closingDate}T12:00:00`);
const closes = Number.isNaN(closesDate.getTime())
  ? null
  : closesDate.toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric' });
const chips = [job.programDepartment, job.employmentType, ...job.scheduleShift].filter(Boolean) as string[];
// Concise accessible name for the whole-row link (the inner text would otherwise
// concatenate title + meta + every chip + CTA into one long, repetitive label).
const linkLabel = [job.title, location, wage].filter(Boolean).join(', ');
---
<a class="job-row" href={`/careers/${job.postingId}`} aria-label={linkLabel}>
  <span class="job-row__main">
    <h3 class="job-row__title">{job.title}</h3>
    <span class="job-row__meta">{location}{wage ? ` · ${wage}` : ''}</span>
    {chips.length > 0 && (
      <span class="job-row__chips">
        {chips.map((c) => <span class="job-row__chip">{c}</span>)}
      </span>
    )}
  </span>
  <span class="job-row__aside">
    {closes && <span class="job-row__closes">Closes {closes}</span>}
    <span class="job-row__cta">View &amp; apply →</span>
  </span>
</a>

<style>
  .job-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding: 1.25rem 1.5rem;
    background: #fff;
    border: 1px solid #e6e6e6;
    border-radius: 14px;
    box-shadow: 0 8px 24px -20px rgb(13 24 33 / 35%);
    text-decoration: none;
    color: #2a2f39;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .job-row:hover,
  .job-row:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 16px 34px -20px rgb(13 24 33 / 45%);
    border-color: #ffc700;
  }

  .job-row__main { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; flex: 1 1 22rem; }
  .job-row__title { margin: 0; font-size: 1.3rem; font-weight: 700; color: #394254; line-height: 1.2; }
  .job-row__meta { font-weight: 600; color: #5f5f5f; font-size: 0.95rem; }
  .job-row__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.15rem; }
  .job-row__chip { font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 999px; background: #f3f2f1; color: #394254; }

  .job-row__aside { display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem; text-align: right; }
  .job-row__closes { font-size: 0.82rem; color: #767676; }
  .job-row__cta { font-weight: 700; color: #394254; white-space: nowrap; }
  .job-row:hover .job-row__cta { color: #c0392b; }

  /* On phones: drop the right column under the content, spread it full width. */
  @media (width <= 560px) {
    .job-row__aside {
      flex-basis: 100%;
      width: 100%;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: left;
      border-top: 1px solid #f0efed;
      padding-top: 0.75rem;
    }
  }
</style>
