---
// One opening, as a card on the careers board. Links to the SSR detail page.
import type { JobPosting } from '../lib/jobs';
interface Props { job: JobPosting }
const { job } = Astro.props;

const location = [job.city, job.region].filter(Boolean).join(', ') || job.home || 'Ontario';
const money = (n: number) => `$${n.toLocaleString('en-CA', { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 })}`;
const unit = job.payBasis === 'Annual' ? '/yr' : '/hr';
const wage = job.wageMin != null && job.wageMax != null && job.wageMax !== job.wageMin
  ? `${money(job.wageMin)}–${money(job.wageMax)}${unit}`
  : job.wageMin != null ? `${money(job.wageMin)}${unit}`
  : job.wageMax != null ? `${money(job.wageMax)}${unit}` : null;
const closes = new Date(`${job.closingDate}T12:00:00`).toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric' });
const chips = [job.programDepartment, job.employmentType, ...job.scheduleShift].filter(Boolean) as string[];
---
<a class="job-card" href={`/careers/${job.postingId}`}>
  <h3 class="job-card__title">{job.title}</h3>
  <p class="job-card__location">{location}{wage ? ` · ${wage}` : ''}</p>
  {chips.length > 0 && (
    <ul class="job-card__chips" aria-label="Details">
      {chips.map((c) => <li>{c}</li>)}
    </ul>
  )}
  {job.shortSummary && <p class="job-card__summary">{job.shortSummary}</p>}
  <span class="job-card__foot">
    <span class="job-card__closes">Closes {closes}</span>
    <span class="job-card__cta">View &amp; apply →</span>
  </span>
</a>

<style>
  .job-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid #e6e6e6;
    border-radius: 14px;
    box-shadow: 0 10px 30px -18px rgb(13 24 33 / 35%);
    text-decoration: none;
    color: #2a2f39;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .job-card:hover,
  .job-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -18px rgb(13 24 33 / 45%);
    border-color: #ffc700;
  }
  .job-card__title { margin: 0; font-size: 1.25rem; line-height: 1.25; color: #394254; }
  .job-card__location { margin: 0; font-weight: 600; color: #5f5f5f; font-size: 0.95rem; }
  .job-card__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.15rem 0 0; padding: 0; list-style: none; }
  .job-card__chips li { font-size: 0.78rem; font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 999px; background: #f3f2f1; color: #394254; }
  .job-card__summary { margin: 0.25rem 0 0; font-size: 0.95rem; line-height: 1.5; color: #4f4f4f; }
  .job-card__foot { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: auto; padding-top: 0.75rem; }
  .job-card__closes { font-size: 0.82rem; color: #767676; }
  .job-card__cta { font-weight: 700; color: #394254; white-space: nowrap; }
  .job-card:hover .job-card__cta { color: #cc4b37; }
</style>
