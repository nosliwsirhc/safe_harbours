---
// A resource post card, rendered from the article registry (single source of
// truth). `variant` controls the title heading: related-posts use <h4>, the
// /resources index uses <h3 class="m-h4">. Title/excerpt/meta are emitted as raw
// HTML because the registry preserves the original entities (e.g. &#8217;).
import { articles } from '../data/articles';

interface Props {
  slug: string;
  variant?: 'related' | 'index';
}
const { slug, variant = 'related' } = Astro.props;
const a = articles[slug];
if (!a) throw new Error(`PostCard: unknown article slug "${slug}"`);
---
<a class="post-card" href={`/resources/${a.slug}/`}>
  <div class="thumbnail-wrap">
    <div class="post-card__thumbnail" style={`background-image: url(${a.thumbnail});`}></div>
  </div>
  <div class="content">
    <div class="title">
      {variant === 'index'
        ? <h3 class="m-h4" set:html={a.cardTitle} />
        : <h4 set:html={a.cardTitle} />}
    </div>
    <div class="excerpt" set:html={a.excerpt} />
    <div class="meta"><p set:html={a.meta} /></div>
  </div>
</a>
