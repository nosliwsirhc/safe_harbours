---
// Resource-article body template: hero + prose (via <slot/>) + author/share
// footer + related posts. Content comes from the resources collection — the
// page renders <ResourceArticle …><Content/></ResourceArticle>. The prose lands
// inside <article> so the theme's `.blog-single article h2/p/ul` styles apply.
import { site } from '../data/site';
import ArticleHero from './ArticleHero.astro';
import AuthorCard from './AuthorCard.astro';
import ShareLinks from './ShareLinks.astro';
import RelatedPosts from './RelatedPosts.astro';

interface Props {
  slug: string;
  title: string;
  heroImage: string;
  related: string[];
}
const { slug, title, heroImage, related } = Astro.props;
const shareUrl = `${site.url}/resources/${slug}/`;
---
<ArticleHero title={title} image={heroImage} />
<section class="blog-single">
  <article>
    <div class="grid-container">
      <div class="grid-x">
        <div class="cell large-11" data-cms-article-body><slot /></div>
        <footer class="cell large-11">
          <div class="wrap">
            <strong class="author-card-title">Author</strong>
            <AuthorCard />
          </div>
          <ShareLinks url={shareUrl} />
        </footer>
      </div>
    </div>
  </article>
  <div class="grid-container">
    <div class="grid-x">
      <div class="cell">
        <RelatedPosts slugs={related} />
      </div>
    </div>
  </div>
</section>
