---
// The /resources index body. The card grid is driven by the article registry
// (PostCard, shared with related-posts). The rest mirrors the captured theme
// verbatim: the hero, the featured post (its own longer excerpt), the FacetWP
// facet placeholders (empty divs filled by facetwp JS at runtime), and the
// newsletter signup form. Only change from the capture: the meaningless
// gf_browser_* server-sniff class is dropped.
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';

// The index grid: articles with an `indexOrder`, in that order.
const indexPosts = (await getCollection('resources'))
  .filter((p) => p.data.indexOrder !== undefined)
  .sort((a, b) => (a.data.indexOrder ?? 0) - (b.data.indexOrder ?? 0));

const featuredHref = '/resources/eligibility-and-requirements-for-becoming-a-foster-parent-in-ontario/';
const featuredTitle = 'Eligibility and Requirements for Becoming a Foster Parent in Ontario';
---
<div class="page-hero blog">
  <div class="grid-container">
    <div class="overlay"></div>
    <div class="background-image" style="background-image: url('/assets/uploads/2024/10/blog-hero-scaled.jpg');"></div>
    <div class="grid-x">
      <div class="cell medium-10">
        <div class="content">
          <p class="lead">Safe harbours</p>
          <h1>Resources</h1>
          <p>From essential training materials to expert advice on trauma-informed care, our resources are designed to help you provide the best possible care for the children in your home.</p>
          <div class="filter">
            <div class="facetwp-facet facetwp-facet-search facetwp-type-search" data-name="search" data-type="search"></div>
          </div>
        </div>
      </div>
    </div>
    <svg class="circle-1 show-for-large" xmlns="http://www.w3.org/2000/svg" width="179" height="179" viewBox="0 0 179 179" fill="none">
      <circle cx="89.2938" cy="89.5107" r="87" transform="rotate(-91.5314 89.2938 89.5107)" fill="#DAB527" fill-opacity="0.89"></circle>
    </svg>
  </div>
</div>

{/* The captured theme leaves .feature-post__container unclosed (the browser
   auto-closes it at #content's end, nesting the grid + newsletter inside it).
   We reproduce that exactly: emit the open tag raw and never close it. */}
<Fragment set:html={'<div class="feature-post__container">'} />
  <div class="feature-post">
    <div class="feature-post__border grid-x">
      <div class="cell medium-6 large-7">
        <a class="feature-post__thumbnail-wrap" href={featuredHref} title={featuredTitle}>
          <p class="badge">Featured Post - (Most Recent)</p>
          <div class="feature-post__thumbnail" style="background-image: url(/assets/uploads/2026/02/foster6.jpg);"></div>
        </a>
      </div>
      <div class="cell medium-6 large-5 align-center-middle">
        <a class="content" href={featuredHref} title={featuredTitle}>
          <div class="title"><h2 class="m-h3">Eligibility and Requirements for Becoming a Foster Parent in Ontario</h2></div>
          <div class="excerpt">What Does It Mean to Be a Foster Parent Becoming a foster parent in Ontario means opening your home to a child or youth who cannot safely live with their family, often during a period...</div>
          <div class="meta"><p>Mar 3rd 2026 By Safe Harbours</p></div>
        </a>
      </div>
    </div>
  </div>

<div class="grid-container">
  <div class="grid-x">
    <div class="cell">
      <div class="filter-drop">
        <p>Sort by Category</p>
        <div class="facetwp-facet facetwp-facet-categories facetwp-type-dropdown" data-name="categories" data-type="dropdown"></div>
      </div>
    </div>
    <div class="grid-x grid-padding-x grid-padding-y">
      {indexPosts.map((p, i) => (
        <div class="cell medium-6 large-4">
          <PostCard slug={p.id} variant={i === 0 ? 'index' : 'related'} />
        </div>
      ))}
    </div>
    <div class="cell filter-loadmore text-center">
      <div class="facetwp-facet facetwp-facet-view_more facetwp-type-pager" data-name="view_more" data-type="pager"></div>
    </div>
  </div>
</div>

<section class="blog-newsletter">
  <div class="grid-container">
    <div class="grid-x align-middle">
      <div class="cell medium-6 large-5">
        <div class="introduction">
          <h3>Sign Up for <br />Email Notifications</h3>
        </div>
      </div>
      <div class="cell medium-6 large-offset-1">
        <div class="gform_wrapper gravity-theme gform-theme--no-framework" data-form-theme="gravity-theme" data-form-index="0" id="gform_wrapper_3">
          <div id="gf_3" class="gform_anchor" tabindex="-1"></div>
          <form class="sh-form" data-endpoint="/api/subscribe" data-source="Resources sign-up" data-success="Thanks — you're subscribed!" novalidate>
            <div class="sh-form-row">
              <div class="sh-field">
                <label for="rs-first">First Name</label>
                <input data-1p-ignore="true" data-lpignore="true" data-bwignore="true" data-form-type="other" id="rs-first" name="first" type="text" autocomplete="given-name" />
              </div>
              <div class="sh-field">
                <label for="rs-last">Last Name</label>
                <input data-1p-ignore="true" data-lpignore="true" data-bwignore="true" data-form-type="other" id="rs-last" name="last" type="text" autocomplete="family-name" />
              </div>
            </div>
            <div class="sh-field">
              <label for="rs-email">Email <span class="sh-req" aria-hidden="true">*</span></label>
              <input data-1p-ignore="true" data-lpignore="true" data-bwignore="true" data-form-type="other" id="rs-email" name="email" type="email" required aria-required="true" autocomplete="email" />
              <span class="sh-err" role="alert"></span>
            </div>
            <div class="cf-turnstile" data-size="flexible"></div>
            <p class="sh-hp" aria-hidden="true">
              <label>Leave this field empty<input data-1p-ignore="true" data-lpignore="true" data-bwignore="true" data-form-type="other" type="text" name="company" tabindex="-1" autocomplete="off" /></label>
            </p>
            <button type="submit" class="button">Sign Up</button>
            <p class="sh-form-error" role="alert"></p>
          </form>
        </div>
        <iframe style="display:none;width:0px;height:0px;" src="about:blank" name="gform_ajax_frame_3" id="gform_ajax_frame_3" title="This iframe contains the logic required to handle Ajax powered Gravity Forms."></iframe>
      </div>
    </div>
  </div>
</section>
