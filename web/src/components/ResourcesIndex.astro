---
// The /resources index body. The card grid is driven by the resources content
// collection. Replaces the (now-dead) FacetWP search/category/load-more — which
// needed the WordPress backend — with a real client-side search + category
// filter over the rendered cards. The featured post is data-driven (the article
// flagged `featured`, else the newest). The hero, newsletter form, etc. mirror
// the captured theme.
import PostCard from './PostCard.astro';
import { cardMeta } from '../lib/format';
import { bgImageSet } from '../lib/img';
import { listArticles } from '../lib/articles';

const all = await listArticles('published');

// Featured: the flagged article, else the most recent by date.
const featured = all.find((a) => a.featured) ?? [...all].sort((a, b) => b.date.getTime() - a.date.getTime())[0];

// The grid: every article with an `indexOrder`, in that order, minus the
// featured one (it has its own slot above the grid).
const gridPosts = all
  .filter((a) => a.indexOrder !== null && a.slug !== featured?.slug)
  .sort((a, b) => (a.indexOrder ?? 0) - (b.indexOrder ?? 0));

// Category options: every distinct category across the listed articles.
const listed = featured ? [featured, ...gridPosts] : gridPosts;
const categories = [...new Set(listed.map((a) => a.category))].sort();

const featuredHref = featured ? `/resources/${featured.slug}/` : '#';
---
<div class="page-hero blog">
  <div class="grid-container">
    <div class="overlay"></div>
    <div class="background-image" style={`background-image: ${bgImageSet('/assets/uploads/2024/10/blog-hero-scaled.jpg')};`}></div>
    <div class="grid-x">
      <div class="cell medium-10">
        <div class="content">
          <p class="lead">Safe harbours</p>
          <h1>Resources</h1>
          <p>From essential training materials to expert advice on trauma-informed care, our resources are designed to help you provide the best possible care for the children in your home.</p>
          <div class="filter">
            <label class="sr-only" for="res-search">Search resources</label>
            <input id="res-search" class="res-search" type="search" placeholder="Search resources…" autocomplete="off" />
          </div>
        </div>
      </div>
    </div>
    <svg class="circle-1 show-for-large" xmlns="http://www.w3.org/2000/svg" width="179" height="179" viewBox="0 0 179 179" fill="none">
      <circle cx="89.2938" cy="89.5107" r="87" transform="rotate(-91.5314 89.2938 89.5107)" fill="#DAB527" fill-opacity="0.89"></circle>
    </svg>
  </div>
</div>

{/* The captured theme leaves .feature-post__container unclosed (the browser
   auto-closes it at #content's end, nesting the grid + newsletter inside it).
   We reproduce that exactly: emit the open tag raw and never close it. */}
<Fragment set:html={'<div class="feature-post__container">'} />
  {featured && (
    <div class="feature-post">
      <div class="feature-post__border grid-x">
        <div class="cell medium-6 large-7">
          <a class="feature-post__thumbnail-wrap" href={featuredHref} title={featured.title}>
            <p class="badge">Featured Post</p>
            <div class="feature-post__thumbnail" style={`background-image: ${bgImageSet(featured.thumbnail || featured.heroImage, 800)};`}></div>
          </a>
        </div>
        <div class="cell medium-6 large-5 align-center-middle">
          <a class="content" href={featuredHref} title={featured.title}>
            <div class="title"><h2 class="m-h3">{featured.title}</h2></div>
            {featured.excerpt && <div class="excerpt">{featured.excerpt}</div>}
            <div class="meta"><p>{cardMeta(featured.date, featured.author)}</p></div>
          </a>
        </div>
      </div>
    </div>
  )}

<div class="grid-container">
  <div class="grid-x">
    <div class="cell">
      <div class="filter-drop">
        <label for="res-cat">Sort by Category</label>
        <select id="res-cat">
          <option value="">All categories</option>
          {categories.map((c) => <option value={c}>{c}</option>)}
        </select>
        <span class="res-count" id="res-count" aria-live="polite"></span>
      </div>
    </div>
    <div class="grid-x grid-padding-x grid-padding-y" id="res-grid">
      {gridPosts.map((p, i) => (
        <div class="cell medium-6 large-4" data-res-card data-category={p.category} data-search={`${p.title} ${p.excerpt} ${p.category}`.toLowerCase()}>
          <PostCard slug={p.slug} article={p} variant={i === 0 ? 'index' : 'related'} />
        </div>
      ))}
    </div>
    <p class="res-empty" id="res-empty" hidden>No resources match your search. <button type="button" id="res-clear">Clear filters</button></p>
  </div>
</div>

<section class="blog-newsletter">
  <div class="grid-container">
    <div class="grid-x align-middle">
      <div class="cell medium-6 large-5">
        <div class="introduction">
          <h3>Sign Up for <br />Email Notifications</h3>
        </div>
      </div>
      <div class="cell medium-6 large-offset-1">
        <div class="gform_wrapper gravity-theme gform-theme--no-framework" data-form-theme="gravity-theme" data-form-index="0" id="gform_wrapper_3">
          <div id="gf_3" class="gform_anchor" tabindex="-1"></div>
          <form class="sh-form" data-endpoint="/api/subscribe" data-source="Resources sign-up" data-success="Thanks — you're subscribed!" novalidate>
            <div class="sh-form-row">
              <div class="sh-field">
                <label for="rs-first">First Name</label>
                <input data-1p-ignore="true" data-lpignore="true" data-bwignore="true" data-form-type="other" id="rs-first" name="first" type="text" autocomplete="given-name" />
              </div>
              <div class="sh-field">
                <label for="rs-last">Last Name</label>
                <input data-1p-ignore="true" data-lpignore="true" data-bwignore="true" data-form-type="other" id="rs-last" name="last" type="text" autocomplete="family-name" />
              </div>
            </div>
            <div class="sh-field">
              <label for="rs-email">Email <span class="sh-req" aria-hidden="true">*</span></label>
              <input data-1p-ignore="true" data-lpignore="true" data-bwignore="true" data-form-type="other" id="rs-email" name="email" type="email" required aria-required="true" autocomplete="email" />
              <span class="sh-err" role="alert"></span>
            </div>
            <div class="cf-turnstile" data-size="flexible"></div>
            <p class="sh-hp" aria-hidden="true">
              <label>Leave this field empty<input data-1p-ignore="true" data-lpignore="true" data-bwignore="true" data-form-type="other" type="text" name="company" tabindex="-1" autocomplete="off" /></label>
            </p>
            <button type="submit" class="button">Sign Up</button>
            <p class="sh-form-error" role="alert"></p>
          </form>
        </div>
        <iframe style="display:none;width:0px;height:0px;" src="about:blank" name="gform_ajax_frame_3" id="gform_ajax_frame_3" title="This iframe contains the logic required to handle Ajax powered Gravity Forms."></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .res-search { width: 100%; max-width: 30rem; border-radius: 1rem; border: 1px solid #fff; padding: 0.6rem 1.25rem; font-family: Montserrat, sans-serif; font-size: 1rem; color: #2a2f39; background: #fff; }
  .res-search::placeholder { color: #565d68; opacity: 1; }
  .res-search:focus { outline: 2px solid #ffc700; }
  .filter-drop { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .filter-drop label { font-size: 16px; font-family: Montserrat, sans-serif; margin: 0; }
  .filter-drop select { padding: 0.4rem 1rem; font-family: Montserrat, sans-serif; }
  .res-count { font-size: 0.9rem; color: #6b7280; margin-left: auto; }
  .res-empty { text-align: center; padding: 2rem 0 3rem; font-size: 1.05rem; color: #394254; }
  .res-empty button { font: inherit; color: #1779ba; background: none; border: 0; text-decoration: underline; cursor: pointer; padding: 0; }
</style>

<script is:inline>
  {
    const search = document.getElementById('res-search');
    const cat = document.getElementById('res-cat');
    const cells = [...document.querySelectorAll('[data-res-card]')];
    const empty = document.getElementById('res-empty');
    const count = document.getElementById('res-count');
    const apply = () => {
      const q = (search.value || '').trim().toLowerCase();
      const c = cat.value;
      let shown = 0;
      for (const cell of cells) {
        const show = (!q || cell.getAttribute('data-search').includes(q)) && (!c || cell.getAttribute('data-category') === c);
        cell.hidden = !show;
        if (show) shown++;
      }
      empty.hidden = shown !== 0;
      count.textContent = shown + (shown === 1 ? ' resource' : ' resources');
    };
    search.addEventListener('input', apply);
    cat.addEventListener('change', apply);
    document.getElementById('res-clear').addEventListener('click', () => { search.value = ''; cat.value = ''; apply(); });
    apply();
  }
</script>
