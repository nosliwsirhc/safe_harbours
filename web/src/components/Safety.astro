---
// safety section: an intro (heading + paragraphs), a fixed decorative image, a
// row of support cards (repeater), and an "important" callout. Markup/classes +
// the decorative circles/image are copied from the mirror. The intro + callout
// are rich HTML (they carry their own headings); the support cards are a repeater.
import type { SafetyData } from '../lib/content';
type Props = SafetyData;
const { content = '', cards = [], important = '' } = Astro.props;
---
<section class="safety">
  <div class="grid-container">
    <div class="grid-x">
      <div class="cell large-6 content-container">
        <div class="content" data-cms-field="content" set:html={content}></div>
      </div>
      <div class="cell large-6">
        <div class="image">
          <span class="circle-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="261" height="261" viewBox="0 0 261 261" fill="none">
              <path d="M251.597 177.225C225.787 244.054 150.689 277.307 83.8591 251.498C17.0296 225.688 -16.2237 150.59 9.5858 83.7602C35.3953 16.9308 110.494 -16.3225 177.323 9.48695C244.153 35.2964 277.406 110.395 251.597 177.225Z" fill="#F88E8A" fill-opacity="0.85"></path>
            </svg>
          </span>
          <span class="circle-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="341" height="341" viewBox="0 0 341 341" fill="none">
              <circle cx="170.5" cy="170.5" r="170.5" fill="#DAB527" fill-opacity="0.89"></circle>
            </svg>
          </span>
          <span class="circle-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="168" height="168" viewBox="0 0 168 168" fill="none">
              <circle opacity="0.7" cx="83.7881" cy="84.284" r="83.3794" transform="rotate(21.1165 83.7881 84.284)" fill="#ECD455"></circle>
            </svg>
          </span>
          <picture>
            <source type="image/avif" srcset="/assets/uploads/2024/10/Family2-1-640.avif 640w" sizes="100vw" />
            <source type="image/webp" srcset="/assets/uploads/2024/10/Family2-1-640.webp 640w" sizes="100vw" />
            <img alt="" src="/assets/uploads/2024/10/Family2-1.png" decoding="async" loading="lazy" width="735" height="732" />
          </picture>
        </div>
      </div>
    </div>
  </div>
  <div class="card-items">
    {cards.map((c, i) => (
      <div class="card" data-cms-item={i}>
        <div class="card-body" data-cms-field="text" set:html={c.text}></div>
      </div>
    ))}
  </div>
  <div class="grid-container">
    <div class="grid-x large-10 align-center">
      <div class="important" data-cms-field="important" set:html={important}></div>
    </div>
  </div>
</section>

<style is:global>
  .safety .card .card-body { color: #fff; font-size: 1.25rem; line-height: 2.1875rem; }
  .safety .card .card-body p { margin: 0; color: #fff; }
</style>
