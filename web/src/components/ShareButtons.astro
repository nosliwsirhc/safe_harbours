---
// Article share row. No third-party widgets or trackers: native Web Share
// (progressive enhancement) + plain share-intent links + copy-to-clipboard.
// Share clicks fire a GA4 `share` event only if the visitor accepted analytics.
interface Props {
  url: string; // full canonical URL
  title: string;
}
const { url, title } = Astro.props;

const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const links = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
  x: `https://twitter.com/intent/tweet?url=${u}&text=${t}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
  email: `mailto:?subject=${t}&body=${t}%0A%0A${u}`,
};

// Filled brand/utility glyphs (24x24, fill=currentColor).
const glyphs = {
  facebook: '<path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.52c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.08 24 18.09 24 12.07Z"/>',
  x: '<path d="M18.24 2.25h3.31l-7.23 8.26L23 21.75h-6.66l-5.21-6.82-5.96 6.82H1.86l7.73-8.84L1 2.25h6.83l4.71 6.23 5.7-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12L17.08 19.77Z"/>',
  linkedin: '<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/>',
  email: '<path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.93 5.49a3 3 0 0 1-3.14 0L1.5 8.67Z"/><path d="M22.5 6.91v-.16a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.16l9.71 5.98a1.5 1.5 0 0 0 1.58 0L22.5 6.91Z"/>',
  link: '<path d="M3.9 12a3.1 3.1 0 0 1 3.1-3.1h4V7H7a5 5 0 0 0 0 10h4v-1.9H7A3.1 3.1 0 0 1 3.9 12ZM8 13h8v-2H8v2Zm9-6h-4v1.9h4a3.1 3.1 0 0 1 0 6.2h-4V17h4a5 5 0 0 0 0-10Z"/>',
  share: '<path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81a3 3 0 1 0-3-3c0 .24.04.47.09.7L8.04 9.81A3 3 0 1 0 6 15a2.99 2.99 0 0 0 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65a2.92 2.92 0 1 0 2.92-2.92Z"/>',
};
const svg = (g: keyof typeof glyphs) =>
  `<svg viewBox="0 0 24 24" aria-hidden="true">${glyphs[g]}</svg>`;
---
<div class="article-share" data-url={url} data-title={title}>
  <span class="share-label">Share this article</span>
  <div class="share-buttons">
    <button type="button" class="share-btn share-native" hidden aria-label="Share" set:html={svg('share')}></button>
    <a class="share-btn" href={links.facebook} target="_blank" rel="noopener" aria-label="Share on Facebook" data-method="Facebook" set:html={svg('facebook')}></a>
    <a class="share-btn" href={links.x} target="_blank" rel="noopener" aria-label="Share on X" data-method="X" set:html={svg('x')}></a>
    <a class="share-btn" href={links.linkedin} target="_blank" rel="noopener" aria-label="Share on LinkedIn" data-method="LinkedIn" set:html={svg('linkedin')}></a>
    <a class="share-btn" href={links.email} aria-label="Share by email" data-method="Email" set:html={svg('email')}></a>
    <button type="button" class="share-btn share-copy" aria-label="Copy link" data-method="Copy link"><span class="copied" aria-hidden="true">Copied</span><span class="share-ic" set:html={svg('link')}></span></button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.article-share').forEach((root) => {
    const url = root.dataset.url || location.href;
    const title = root.dataset.title || document.title;
    const track = (method: string) =>
      (window as any).gtag?.('event', 'share', { method, content_type: 'article', item_id: location.pathname });

    // Native share sheet, only where supported.
    const nativeBtn = root.querySelector<HTMLButtonElement>('.share-native');
    if (nativeBtn && typeof navigator.share === 'function') {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener('click', async () => {
        try { await navigator.share({ title, url }); track('Native'); } catch { /* dismissed */ }
      });
    }

    root.querySelectorAll<HTMLAnchorElement>('a[data-method]').forEach((a) =>
      a.addEventListener('click', () => track(a.dataset.method || 'Link'))
    );

    const copyText = async (text: string): Promise<boolean> => {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch { /* fall through to legacy path */ }
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      } catch { return false; }
    };

    const copyBtn = root.querySelector<HTMLButtonElement>('.share-copy');
    copyBtn?.addEventListener('click', async () => {
      if (!(await copyText(url))) return;
      copyBtn.classList.add('is-copied');
      track('Copy link');
      setTimeout(() => copyBtn.classList.remove('is-copied'), 1800);
    });
  });
</script>
