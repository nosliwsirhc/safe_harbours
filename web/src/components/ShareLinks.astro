---
// Article share buttons (LinkedIn + Facebook). The share URL is the article's
// canonical URL. Matches the captured theme's raw (unencoded) share hrefs.
interface Props { url: string }
const { url } = Astro.props;
---
<div class="share">
  SHARE
  <ul class="social-share__list">
    <li class="social-share__list-item">
      <a href={`http://www.linkedin.com/shareArticle?mini=true&url=${url}`} target="_blank" rel="noopener" class="icon-linkedin">
        <i class="fab fa-linkedin-in"></i>
      </a>
    </li>
    <li class="social-share__list-item">
      <a href={`http://www.facebook.com/sharer.php?u=${url}`} target="_blank" rel="noopener" class="icon-facebook">
        <i class="fab fa-facebook-f"></i>
      </a>
    </li>
  </ul>
</div>
