---
import { site, footerNav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer has-deco">
  <span class="deco deco--gold" style="width:160px;height:160px;bottom:-70px;right:6%;opacity:.18"></span>
  <span class="deco deco--ring-coral" style="width:110px;height:110px;top:-30px;left:8%;opacity:.18"></span>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <h2>Explore</h2>
        <ul>
          {footerNav.explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          {footerNav.more.slice(2).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Connect</h2>
        <ul>
          <li><a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a></li>
          <li><a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </div>
      <div>
        <h2>Get in Touch</h2>
        <ul>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={site.emailHref}>{site.email}</a></li>
          <li>{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postal}</li>
        </ul>
        <ul style="margin-top:14px">
          {footerNav.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div class="newsletter">
        <h2>Subscribe to our newsletter</h2>
        <form class="foot-newsletter" id="newsletter-form" novalidate>
          <input type="text" name="name" placeholder="Your Name" autocomplete="name" aria-label="Your name" />
          <input type="email" name="email" placeholder="Your Email" autocomplete="email" required aria-label="Your email" />
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px" />
          <p class="fine">By entering your email, you agree to our <a href="/terms-conditions">Terms &amp; Conditions</a> and <a href="/privacy-policy">Privacy Policy</a>. You can unsubscribe at any time.</p>
          <button type="submit" class="btn btn-gold" id="newsletter-btn">Submit</button>
          <p class="form-ok-msg" id="newsletter-ok" role="status" hidden>Thanks — you’re subscribed!</p>
        </form>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; {year} {site.legalName}. All rights reserved.</span>
      <span>Treatment foster care in Ontario, Canada</span>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  if (form) {
    const btn = document.getElementById('newsletter-btn') as HTMLButtonElement | null;
    const ok = document.getElementById('newsletter-ok') as HTMLElement | null;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      if (!email) { (form.querySelector('[name=email]') as HTMLInputElement)?.focus(); return; }
      if (btn) { btn.disabled = true; btn.textContent = 'Submitting…'; }
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name: fd.get('name'), email, company: fd.get('company') }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          form.querySelectorAll('input').forEach((i) => ((i as HTMLInputElement).value = ''));
          if (ok) ok.hidden = false;
          if (btn) { btn.textContent = 'Subscribed'; }
        } else {
          if (btn) { btn.disabled = false; btn.textContent = 'Submit'; }
          alert(data.error || 'Something went wrong. Please try again.');
        }
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = 'Submit'; }
      }
    });
  }
</script>
