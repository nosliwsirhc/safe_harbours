---
// The WordPress-generated inline <head> styles, which were byte-identical across
// every mirrored page. Kept once here (set:html, verbatim) instead of duplicated
// per page. If a future page needs extra inline head CSS, add a `headExtra` slot
// rather than diverging this shared block.
import headStyles from '../styles/wp-inline-head.html?raw';
---
<Fragment set:html={headStyles} />
