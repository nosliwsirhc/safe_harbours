---
// Renders a faithfully-mirrored WordPress-theme page. Reads the captured
// markup/styles produced by scripts/mirror.mjs (in _mirror/) and emits the
// page verbatim, self-hosting the theme CSS/JS + assets under /wp/.
import { site } from '../data/site';
import ConsentBanner from '../components/ConsentBanner.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OffCanvasNav from '../components/OffCanvasNav.astro';
import { getSettings } from '../lib/content';

// Site-wide settings (Google tag ids) from D1. On SSR pages these are live; on
// prerendered pages getSettings() runs at BUILD time (env.DB is empty → {}), so
// the tags only bake into static pages at build. SSR pages (e.g. /our-story)
// reflect /admin edits immediately. Graceful: empty on any error.
const settings = await getSettings();
const ga4Id = settings.ga4_id || '';
const gtmId = settings.gtm_id || '';

// Inline the per-page <main> content at BUILD time (Vite ?raw) — the Cloudflare
// prerender runtime has no node:fs, so we can't read files at render time. The
// surrounding chrome (head styles, header, footer, off-canvas) is now composed
// from components rather than injected as a blob.
interface MirrorMeta {
  title?: string;
  description?: string;
  styles: string[];
  bodyClass?: string;
  script: string;
}
const mains = import.meta.glob('../../_mirror/*.main.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const metas = import.meta.glob('../../_mirror/*.meta.json', { import: 'default', eager: true }) as Record<string, MirrorMeta>;

interface Props {
  name: string;            // mirror basename, e.g. "home"
  title?: string;
  description?: string;
}
const { name, title, description } = Astro.props;

const mainHtml = mains[`../../_mirror/${name}.main.html`] ?? '';
const meta = metas[`../../_mirror/${name}.meta.json`];
if (!meta) {
  throw new Error(
    `ThemeLayout: no mirror found for "${name}". Expected _mirror/${name}.main.html + .meta.json.`
  );
}

// Site key for the mirrored Cloudflare Turnstile widgets (forms-bridge applies
// it to the .cf-turnstile containers so it matches the Worker's secret).
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

// Content-hash the theme assets we iterate on so an edit busts the 1-day cache
// immediately. The _headers cache rules match by path (the ?v query is ignored),
// so each versioned URL still gets the long, immutable-style cache. Without this,
// a tuned a11y/forms file keeps serving the previous version for up to a day —
// which makes already-fixed changes look like live regressions.
const assetRaw = import.meta.glob(
  ['../../public/assets/a11y-overrides.css', '../../public/assets/forms.js'],
  { query: '?raw', import: 'default', eager: true }
) as Record<string, string>;
const hashStr = (s: string) => {
  let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0;
  return h.toString(36);
};
const ver = (publicPath: string) => {
  const raw = assetRaw[`../../public${publicPath}`];
  return raw ? `${publicPath}?v=${hashStr(raw)}` : publicPath;
};

const SITE_DESC =
  'Safe Harbours is an Ontario treatment foster care agency — training, on-call support, and a dedicated case management team help foster families give children stability.';
const pageTitle = title ?? meta.title ?? site.name;
const pageDesc = description || meta.description || SITE_DESC;
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(cleanPath || '/', site.url).href;

// Structured data (mirroring stripped the WP JSON-LD). Helps search + AI agents
// understand the organization.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: `${site.url}/images/og-default.jpg`,
  image: `${site.url}/images/og-default.jpg`,
  description: SITE_DESC,
  telephone: site.phoneHref.replace('tel:', ''),
  email: site.email,
  areaServed: { '@type': 'State', name: 'Ontario, Canada' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.street}, 1st Floor`,
    addressLocality: site.address.city,
    addressRegion: 'ON',
    postalCode: site.address.postal,
    addressCountry: 'CA',
  },
  sameAs: [site.social.facebook, site.social.instagram, site.social.linkedin],
};
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    {/* Analytics. Consent Mode v2 defaults to denied BEFORE any tag loads, so no
        GTM/GA tag writes cookies until the visitor accepts — the consent banner
        flips it to granted. GTM loads on every page once its container ID is set
        in /admin/settings; GA4 loads through the consent banner (one place, no
        double-counting). gtag() is defined once here and shared by both. */}
    <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',wait_for_update:500});`} />
    {gtmId && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`} />
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {pageDesc && <meta name="description" content={pageDesc} />}
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <meta name="theme-color" content="#484e5e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/og-default.jpg', site.url).href} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    />
    {meta.styles.map((href: string) => <link rel="stylesheet" href={href} />)}
    <link rel="stylesheet" href={ver('/assets/a11y-overrides.css')} />
    <SiteHead />
  </head>
  <body class={meta.bodyClass}>
    <a class="a11y-skip-content-link" href="#content">Skip To Content</a>
    <div class="off-canvas-wrapper">
      <OffCanvasNav path={cleanPath} />
      <div class="off-canvas-content" data-off-canvas-content>
        <SiteHeader path={cleanPath} />
        <main class="site-content">
          <div id="content" class="site-content__start">
            {Astro.slots.has('default') ? <slot /> : <Fragment set:html={mainHtml} />}
          </div>
        </main>
        <SiteFooter path={cleanPath} />
      </div>
    </div>
    <ConsentBanner ga4Id={ga4Id} gtmId={gtmId} />
    {/* Conversion events → dataLayer (for GTM/GA4). Phone-call + email clicks are
        tracked everywhere; CTA clicks fire for elements marked data-cta or links
        to the key conversion pages. Form submits push generate_lead (forms.js). */}
    <script is:inline set:html={`
      (function () {
        window.dataLayer = window.dataLayer || [];
        var KEY_CTA = /\\/(become-a-foster-parent|book-an-appointment)(\\/|$|\\?)/;
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest && e.target.closest('a, [data-cta]');
          if (!a) return;
          var href = a.getAttribute('href') || '';
          var text = (a.textContent || '').trim().slice(0, 100);
          if (href.indexOf('tel:') === 0) {
            window.dataLayer.push({ event: 'phone_call', link_url: href, link_text: text });
          } else if (href.indexOf('mailto:') === 0) {
            window.dataLayer.push({ event: 'email_click', link_url: href, link_text: text });
          } else if (a.hasAttribute('data-cta') || KEY_CTA.test(href)) {
            window.dataLayer.push({ event: 'cta_click', cta_label: a.getAttribute('data-cta') || text, cta_url: href });
          }
        }, true);
      })();
    `} />
    <script is:inline define:vars={{ turnstileKey }}>window.__TS_KEY = turnstileKey;</script>
    <script src={meta.script} defer is:inline></script>
    <script src={ver('/assets/forms.js')} defer is:inline></script>
  </body>
</html>
