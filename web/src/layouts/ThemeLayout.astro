---
// Renders a faithfully-mirrored WordPress-theme page. Reads the captured
// markup/styles produced by scripts/mirror.mjs (in _mirror/) and emits the
// page verbatim, self-hosting the theme CSS/JS + assets under /wp/.
import { site } from '../data/site';
import ConsentBanner from '../components/ConsentBanner.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OffCanvasNav from '../components/OffCanvasNav.astro';
import { getSettings } from '../lib/content';
import { safeMarketingPixels } from '../lib/pixel-ids';
import { safeGa4Id, safeGtmId } from '../lib/tag-ids';
import { safeFormConversions } from '../lib/form-conversions';

// Site-wide settings (Google tag ids) from D1. On SSR pages these are live; on
// prerendered pages getSettings() runs at BUILD time (env.DB is empty → {}), so
// the tags only bake into static pages at build. SSR pages (e.g. /our-story)
// reflect /admin edits immediately. Graceful: empty on any error.
// gtm_id is interpolated RAW into the inline GTM loader below, so pass both ids
// through the validators — a malformed/unsafe stored value is dropped here rather
// than injected (stored-XSS guard, paired with the write-time check in settings).
const settings = await getSettings();
const ga4Id = safeGa4Id(settings.ga4_id);
const gtmId = safeGtmId(settings.gtm_id);

// Marketing pixels (Meta / TikTok / LinkedIn / Google Ads), preset-only. Each ID
// is re-validated here at inject time, so only a well-formed value reaches the
// page — a malformed/unsafe stored value is dropped, never injected. The pixels
// load behind the consent banner (see the consent-gated loader in <body>).
const pixels = safeMarketingPixels(settings.marketing_pixels);

// Per-form conversion config (custom event name per form) for forms.js. Validated
// here so only well-formed values are injected; the thank-you redirect is returned
// by the API handlers, not needed client-side.
const formConversions = safeFormConversions(settings.form_conversions);

// Inline the per-page <main> content at BUILD time (Vite ?raw) — the Cloudflare
// prerender runtime has no node:fs, so we can't read files at render time. The
// surrounding chrome (head styles, header, footer, off-canvas) is now composed
// from components rather than injected as a blob.
interface MirrorMeta {
  title?: string;
  description?: string;
  styles: string[];
  bodyClass?: string;
  script: string;
}
const mains = import.meta.glob('../../_mirror/*.main.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const metas = import.meta.glob('../../_mirror/*.meta.json', { import: 'default', eager: true }) as Record<string, MirrorMeta>;

interface Props {
  name: string;            // mirror basename, e.g. "home"
  title?: string;
  description?: string;
  noindex?: boolean;       // emit <meta robots noindex> (campaign pages default to this)
}
const { name, title, description, noindex } = Astro.props;

const mainHtml = mains[`../../_mirror/${name}.main.html`] ?? '';
const meta = metas[`../../_mirror/${name}.meta.json`];
if (!meta) {
  throw new Error(
    `ThemeLayout: no mirror found for "${name}". Expected _mirror/${name}.main.html + .meta.json.`
  );
}

// Site key for the mirrored Cloudflare Turnstile widgets (forms-bridge applies
// it to the .cf-turnstile containers so it matches the Worker's secret).
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

// Content-hash the theme assets we iterate on so an edit busts the 1-day cache
// immediately. The _headers cache rules match by path (the ?v query is ignored),
// so each versioned URL still gets the long, immutable-style cache. Without this,
// a tuned a11y/forms file keeps serving the previous version for up to a day —
// which makes already-fixed changes look like live regressions.
const assetRaw = import.meta.glob(
  ['../../public/assets/a11y-overrides.css', '../../public/assets/forms.js'],
  { query: '?raw', import: 'default', eager: true }
) as Record<string, string>;
const hashStr = (s: string) => {
  let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0;
  return h.toString(36);
};
const ver = (publicPath: string) => {
  const raw = assetRaw[`../../public${publicPath}`];
  return raw ? `${publicPath}?v=${hashStr(raw)}` : publicPath;
};

const SITE_DESC =
  'Safe Harbours is an Ontario treatment foster care agency — training, on-call support, and a dedicated case management team help foster families give children stability.';
const pageTitle = title ?? meta.title ?? site.name;
const pageDesc = description || meta.description || SITE_DESC;
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(cleanPath || '/', site.url).href;

// Structured data (mirroring stripped the WP JSON-LD). Helps search + AI agents
// understand the organization.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: `${site.url}/images/og-default.jpg`,
  image: `${site.url}/images/og-default.jpg`,
  description: SITE_DESC,
  telephone: site.phoneHref.replace('tel:', ''),
  email: site.email,
  areaServed: { '@type': 'State', name: 'Ontario, Canada' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.street}, 1st Floor`,
    addressLocality: site.address.city,
    addressRegion: 'ON',
    postalCode: site.address.postal,
    addressCountry: 'CA',
  },
  sameAs: [site.social.facebook, site.social.instagram, site.social.linkedin],
};
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    {/* Analytics. Consent Mode v2 defaults to denied BEFORE any tag loads, so no
        GTM/GA tag writes cookies until the visitor accepts — the consent banner
        flips it to granted. GTM loads on every page once its container ID is set
        in /admin/settings; GA4 loads through the consent banner (one place, no
        double-counting). gtag() is defined once here and shared by both. */}
    <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',wait_for_update:500});`} />
    {gtmId && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`} />
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {pageDesc && <meta name="description" content={pageDesc} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <meta name="theme-color" content="#484e5e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/og-default.jpg', site.url).href} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    />
    {meta.styles.map((href: string) => <link rel="stylesheet" href={href} />)}
    <link rel="stylesheet" href={ver('/assets/a11y-overrides.css')} />
    <SiteHead />
  </head>
  <body class={meta.bodyClass}>
    <a class="a11y-skip-content-link" href="#content">Skip To Content</a>
    <div class="off-canvas-wrapper">
      <OffCanvasNav path={cleanPath} />
      <div class="off-canvas-content" data-off-canvas-content>
        <SiteHeader path={cleanPath} />
        <main class="site-content">
          <div id="content" class="site-content__start">
            {Astro.slots.has('default') ? <slot /> : <Fragment set:html={mainHtml} />}
          </div>
        </main>
        <SiteFooter path={cleanPath} />
      </div>
    </div>
    <ConsentBanner ga4Id={ga4Id} gtmId={gtmId} />
    {/* Marketing pixels (Meta / TikTok / LinkedIn / Google Ads), loaded ONLY after
        the visitor accepts (these third-party pixels aren't Consent-Mode aware, so
        we gate them ourselves): load now if consent was already granted, else wait
        for the banner's `sh-consent-granted` event. IDs are server-validated, so
        they're injected as plain values — never string-built — and the manager is
        preset-only, so there's no raw <script> to inject. */}
    <script is:inline define:vars={{ pixels }}>
      (function () {
        var P = pixels || {};
        if (!P.meta && !P.tiktok && !P.linkedin && !P.google_ads) return;
        function load() {
          if (window.__shPixelsLoaded) return;
          window.__shPixelsLoaded = true;
          if (P.meta) {
            !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
            window.fbq('init', P.meta); window.fbq('track', 'PageView');
          }
          if (P.tiktok) {
            !function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];ttq.methods=['page','track','identify','instances','debug','on','off','once','ready','alias','group','enableCookie','disableCookie','holdConsent','revokeConsent','grantConsent'];ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};ttq.load=function(e,n){var r='https://analytics.tiktok.com/i18n/pixel/events.js';ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=r;ttq._t=ttq._t||{};ttq._t[e]=+new Date;ttq._o=ttq._o||{};ttq._o[e]=n||{};var s=d.createElement('script');s.type='text/javascript';s.async=!0;s.src=r+'?sdkid='+e+'&lib='+t;var a=d.getElementsByTagName('script')[0];a.parentNode.insertBefore(s,a)};ttq.load(P.tiktok);ttq.page();}(window,document,'ttq');
          }
          if (P.linkedin) {
            window._linkedin_partner_id = P.linkedin;
            window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
            window._linkedin_data_partner_ids.push(P.linkedin);
            (function(l){if(!l){window.lintrk=function(a,b){window.lintrk.q.push([a,b])};window.lintrk.q=[]}var s=document.getElementsByTagName('script')[0];var b=document.createElement('script');b.type='text/javascript';b.async=!0;b.src='https://snap.licdn.com/li.lms-analytics/insight.min.js';s.parentNode.insertBefore(b,s)})(window.lintrk);
          }
          if (P.google_ads) {
            var gs = document.createElement('script'); gs.async = true;
            gs.src = 'https://www.googletagmanager.com/gtag/js?id=' + P.google_ads;
            document.head.appendChild(gs);
            if (window.gtag) window.gtag('config', P.google_ads);
          }
        }
        var granted = false;
        try { granted = localStorage.getItem('sh-consent') === 'granted'; } catch (e) {}
        if (granted) { load(); return; }
        window.addEventListener('sh-consent-granted', load, { once: true });
      })();
    </script>
    {/* Conversion events → dataLayer (for GTM/GA4). Phone-call + email clicks are
        tracked everywhere; CTA clicks fire for elements marked data-cta or links
        to the key conversion pages. Form submits push generate_lead (forms.js). */}
    <script is:inline set:html={`
      (function () {
        window.dataLayer = window.dataLayer || [];
        var KEY_CTA = /\\/(become-a-foster-parent|book-an-appointment)(\\/|$|\\?)/;
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest && e.target.closest('a, [data-cta]');
          if (!a) return;
          var href = a.getAttribute('href') || '';
          var text = (a.textContent || '').trim().slice(0, 100);
          if (href.indexOf('tel:') === 0) {
            window.dataLayer.push({ event: 'phone_call', link_url: href, link_text: text });
          } else if (href.indexOf('mailto:') === 0) {
            window.dataLayer.push({ event: 'email_click', link_url: href, link_text: text });
          } else if (a.hasAttribute('data-cta') || KEY_CTA.test(href)) {
            window.dataLayer.push({ event: 'cta_click', cta_label: a.getAttribute('data-cta') || text, cta_url: href });
          }
        }, true);
      })();
    `} />
    <script is:inline define:vars={{ turnstileKey, formConversions }}>window.__TS_KEY = turnstileKey; window.__SH_FORM_CONV = formConversions;</script>
    <script src={meta.script} defer is:inline></script>
    <script src={ver('/assets/forms.js')} defer is:inline></script>
  </body>
</html>
