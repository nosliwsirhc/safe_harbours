---
// Admin: the list of resource articles. Create / edit / delete; status shows
// whether an article is live (published) or a draft. Authoring happens in the
// per-article editor.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { isAuthed } from '../../../lib/admin';
import { listAdminArticles } from '../../../lib/articles';

if (!(await isAuthed(Astro.request))) return Astro.redirect('/admin/login');

const articles = await listAdminArticles();
const fmt = (d: Date) => (Number.isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' }));
---
<AdminLayout title="Resources" active="articles">
  <main class="wrap">
    <div class="head">
      <h1>Resource articles</h1>
      <button type="button" class="btn btn--primary" id="new">+ New article</button>
    </div>
    <p class="muted intro">Create and edit the articles on the Resources page. Changes save as a private draft; publish to put them live.</p>

    <div class="newform" id="newform" hidden>
      <label class="sr-only" for="new-title">New article title</label>
      <input id="new-title" type="text" placeholder="Article title…" autocomplete="off" />
      <button type="button" class="btn btn--primary" id="new-create">Create</button>
      <button type="button" class="btn btn--ghost" id="new-cancel">Cancel</button>
    </div>

    {articles.length === 0 && <p class="empty muted">No articles yet. Click “New article” to write your first one.</p>}

    <ul class="list" role="list">
      {articles.map((a) => (
        <li class="row">
          <a class="row__main" href={`/admin/articles/${a.slug}`}>
            <span class="row__title">{a.title || a.slug}</span>
            <span class="row__meta muted">{[fmt(a.date), a.category].filter(Boolean).join(' · ')}</span>
          </a>
          <span class:list={['badge', a.published ? 'badge--live' : 'badge--draft']}>{a.published ? 'Live' : 'Draft'}</span>
          <a class="btn btn--ghost row__edit" href={`/admin/articles/${a.slug}`}>Edit</a>
          <button type="button" class="btn btn--quiet row__del" data-slug={a.slug} data-title={a.title || a.slug}>Delete</button>
        </li>
      ))}
    </ul>
  </main>

  <style>
    .wrap { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.5rem; }
    .head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    h1 { font-size: 1.6rem; margin: 0; }
    .intro { margin: 0.4rem 0 1.75rem; }
    .empty { padding: 2rem 0; }
    .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
    .row { display: flex; align-items: center; gap: 0.85rem; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.75rem 1rem; box-shadow: var(--shadow); }
    .row__main { flex: 1; min-width: 0; text-decoration: none; color: inherit; display: grid; gap: 0.15rem; }
    .row__title { font-weight: 600; }
    .row__meta { font-size: 0.85rem; }
    .badge { font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.55rem; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.03em; }
    .badge--live { color: var(--ok); background: var(--ok-bg); }
    .badge--draft { color: var(--warn); background: var(--warn-bg); }
    .row__edit { padding: 0.35rem 0.8rem; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

    /* base display:none so the [hidden] attr wins; .newform sets flex only when shown */
    .newform { display: none; gap: 0.5rem; align-items: center; margin: 0 0 1.5rem; }
    .newform:not([hidden]) { display: flex; }
    .newform input { flex: 1; font: inherit; border: 1px solid var(--line); border-radius: 8px; padding: 0.55rem 0.7rem; background: #fff; }
    .newform input:focus { outline: 2px solid var(--brand); border-color: var(--brand); }
    .confirm { display: inline-flex; gap: 0.4rem; align-items: center; font-size: 0.85rem; color: var(--danger); font-weight: 600; }
    .confirm .yes { color: var(--danger); }
  </style>

  <script is:inline>
    {
      const newBtn = document.getElementById('new');
      const newForm = document.getElementById('newform');
      const newTitle = document.getElementById('new-title');
      const createBtn = document.getElementById('new-create');
      const openNew = () => { newForm.hidden = false; newBtn.hidden = true; newTitle.focus(); };
      const closeNew = () => { newForm.hidden = true; newBtn.hidden = false; newTitle.value = ''; createBtn.disabled = false; };
      newBtn.addEventListener('click', openNew);
      document.getElementById('new-cancel').addEventListener('click', closeNew);
      const create = async () => {
        const title = newTitle.value.trim();
        if (!title) { newTitle.focus(); return; }
        createBtn.disabled = true; createBtn.textContent = 'Creating…';
        try {
          const res = await fetch('/api/admin/articles', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'create', title }) });
          const data = await res.json();
          if (data.ok && data.slug) { location.href = `/admin/articles/${data.slug}`; return; }
        } catch {}
        createBtn.disabled = false; createBtn.textContent = 'Create';
        newTitle.setCustomValidity('Could not create — try again.'); newTitle.reportValidity();
      };
      createBtn.addEventListener('click', create);
      newTitle.addEventListener('input', () => newTitle.setCustomValidity(''));
      newTitle.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); create(); } if (e.key === 'Escape') closeNew(); });

      // Inline delete confirm (no native dialog).
      for (const btn of document.querySelectorAll('.row__del')) {
        btn.addEventListener('click', () => {
          const row = btn.closest('.row');
          if (row.querySelector('.confirm')) return;
          btn.style.display = 'none';
          const c = document.createElement('span');
          c.className = 'confirm';
          c.innerHTML = 'Delete? <button type="button" class="btn btn--quiet yes">Delete</button><button type="button" class="btn btn--quiet no">Keep</button>';
          btn.after(c);
          const cancel = () => { c.remove(); btn.style.display = ''; };
          c.querySelector('.no').addEventListener('click', cancel);
          c.querySelector('.yes').addEventListener('click', async () => {
            try {
              const res = await fetch('/api/admin/articles', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'delete', slug: btn.dataset.slug }) });
              if ((await res.json()).ok) { row.remove(); return; }
            } catch {}
            cancel();
          });
          c.querySelector('.yes').focus();
        });
      }
    }
  </script>
</AdminLayout>
