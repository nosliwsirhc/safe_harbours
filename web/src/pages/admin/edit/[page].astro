---
// The live-preview editor. ONE engine for every page: a page is an ordered list
// of typed component blocks (hero / heading / text / image+text / cta). The page
// config (lib/pages.ts) just constrains the engine — a fixed single block (hero),
// an add/remove/reorder list of one kind (numbered steps), or the full palette.
// Edits autosave to a DRAFT; nothing is public until "Publish". The preview iframe
// shows the draft (?preview=1). Each block carries a data-cms-block index whose
// data-cms-field children let us patch the preview in place without a reload.
// The composer engine itself is the shared /assets/composer.js (also used by the
// campaign-page editor); this route just hands it config + the save/publish targets.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { isAuthed } from '../../../lib/admin';
import { getBlocksForView, hasUnpublishedChanges } from '../../../lib/content';
import { findPage } from '../../../lib/pages';
import '../../../styles/admin-editor.css';

if (!(await isAuthed(Astro.request))) return Astro.redirect('/admin/login');

const key = Astro.params.page;
const page = key ? findPage(key) : undefined;
if (!page) return Astro.redirect('/admin');

const blocks = (await getBlocksForView(page.key, page.slot, true)).map((b) => ({ kind: b.kind, body: b.body }));
const unpublished = await hasUnpublishedChanges(page.key, page.slot);
const previewSrc = `${page.path}?preview=1`;

const single = page.single ?? null;
const showPalette = page.palette.length > 0;
const config = {
  palette: page.palette,
  single,
  numbered: page.numbered ?? false,
  addLabel: page.addLabel ?? null,
};

// Config handed to the shared composer engine: the engine constraints, the draft
// blocks, and where to autosave / publish (this page's content_blocks (page, slot)).
const composerConfig = {
  config,
  blocks,
  save: { url: '/api/admin/blocks', body: { page: page.key, slot: page.slot } },
  publish: { url: '/api/admin/publish', body: { page: page.key, slot: page.slot } },
};
---
<AdminLayout title={`Editing ${page.name}`} active="pages">
  <div id="errbar" class="errbar" role="alert" hidden>
    ⚠ Couldn’t save your changes — check your connection.
    <button type="button" id="retry">Try again</button>
  </div>
  <div class="editor">
    <section class="pane pane--edit">
      <div class="topbar">
        <a class="back" href="/admin">← All pages</a>
        <div class="pub">
          <span class="save" id="save" data-state="saved" role="status" aria-live="polite">Saved</span>
          <button type="button" class="btn btn--primary" id="publish" disabled={!unpublished}>Publish changes</button>
        </div>
      </div>
      <h1>{page.name}</h1>
      <p class="livenote" id="livenote" data-pending={String(unpublished)}>
        {unpublished
          ? 'You have unpublished changes. Click “Publish changes” to put them on the live site.'
          : 'This page is up to date with the live site.'}
      </p>
      <p class="muted hint">
        {single
          ? 'Edit the content below — it saves automatically. Click “Publish changes” to put it on the live site.'
          : config.numbered
            ? (
              <Fragment>
                Edit each step, and drag the <span class="grip-inline">⠿</span> handle to reorder — steps are numbered
                automatically. Add or remove steps below.
              </Fragment>
            )
            : (
              <Fragment>
                Build the page from sections. Add one below, edit it, and drag the <span class="grip-inline">⠿</span>
                handle to reorder. It saves automatically.
              </Fragment>
            )}
      </p>

      <ol class="sections" id="composer" role="list"></ol>

      {showPalette && (
        <div class="palette">
          <span class="palette-label">Add a section</span>
          <div id="palette" class="palette-btns"></div>
        </div>
      )}
    </section>

    <section class="pane pane--preview">
      <div class="preview__bar">
        <span class="muted">Live preview</span>
        <div class="preview__bar-right">
          <div class="preview__viewport" role="group" aria-label="Preview width">
            <button type="button" data-vp="desktop" aria-pressed="true" title="Desktop">Desktop</button>
            <button type="button" data-vp="tablet" aria-pressed="false" title="Tablet">Tablet</button>
            <button type="button" data-vp="mobile" aria-pressed="false" title="Mobile">Mobile</button>
          </div>
          <a href={page.path} target="_blank" rel="noopener">Open ↗</a>
        </div>
      </div>
      <iframe id="preview" src={previewSrc} title={`Preview of ${page.name}`}></iframe>
    </section>
  </div>

  <style>
    .hint { margin: 0 0 1.5rem; font-size: 0.92rem; }
    .grip-inline { color: var(--muted); }

    .sections { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.85rem; }

    /* palette */
    .palette { border: 1px dashed var(--line); border-radius: var(--radius); padding: 1rem; text-align: center; }
    .palette-label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--muted); margin-bottom: 0.6rem; }
    .palette-btns { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
    .palette-btns .btn { flex: 0 0 auto; }
  </style>

  <script src="/assets/sortable.min.js" is:inline></script>
  <script>
    import { initRichText } from '../../../lib/rich-text-client';
    import { initPreviewViewport } from '../../../lib/preview-viewport';
    initRichText();
    initPreviewViewport();
  </script>
  <script type="application/json" id="cms-composer-config" is:inline set:html={JSON.stringify(composerConfig)}></script>
  <script src="/assets/composer.js" is:inline></script>
</AdminLayout>
