---
// The live-preview editor. ONE engine for every page: a page is an ordered list
// of typed component blocks (hero / heading / text / image+text / cta). The page
// config (lib/pages.ts) just constrains the engine — a fixed single block (hero),
// an add/remove/reorder list of one kind (numbered steps), or the full palette.
// Edits autosave to a DRAFT; nothing is public until "Publish". The preview iframe
// shows the draft (?preview=1). Each block carries a data-cms-block index whose
// data-cms-field children let us patch the preview in place without a reload.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { isAuthed } from '../../../lib/admin';
import { getBlocksForView, hasUnpublishedChanges } from '../../../lib/content';
import { findPage } from '../../../lib/pages';
import '../../../styles/admin-editor.css';

if (!isAuthed(Astro.request)) return Astro.redirect('/admin/login');

const key = Astro.params.page;
const page = key ? findPage(key) : undefined;
if (!page) return Astro.redirect('/admin');

const blocks = (await getBlocksForView(page.key, page.slot, true)).map((b) => ({ kind: b.kind, body: b.body }));
const unpublished = await hasUnpublishedChanges(page.key, page.slot);
const previewSrc = `${page.path}?preview=1`;

const single = page.single ?? null;
const showPalette = page.palette.length > 0;
const config = {
  palette: page.palette,
  single,
  numbered: page.numbered ?? false,
  addLabel: page.addLabel ?? null,
};
---
<AdminLayout title={`Editing ${page.name}`} active="pages">
  <div id="errbar" class="errbar" role="alert" hidden>
    ⚠ Couldn’t save your changes — check your connection.
    <button type="button" id="retry">Try again</button>
  </div>
  <div class="editor">
    <section class="pane pane--edit">
      <div class="topbar">
        <a class="back" href="/admin">← All pages</a>
        <div class="pub">
          <span class="save" id="save" data-state="saved" role="status" aria-live="polite">Saved</span>
          <button type="button" class="btn btn--primary" id="publish" disabled={!unpublished}>Publish changes</button>
        </div>
      </div>
      <h1>{page.name}</h1>
      <p class="livenote" id="livenote" data-pending={String(unpublished)}>
        {unpublished
          ? 'You have unpublished changes. Click “Publish changes” to put them on the live site.'
          : 'This page is up to date with the live site.'}
      </p>
      <p class="muted hint">
        {single
          ? 'Edit the content below — it saves automatically. Click “Publish changes” to put it on the live site.'
          : config.numbered
            ? (
              <Fragment>
                Edit each step, and drag the <span class="grip-inline">⠿</span> handle to reorder — steps are numbered
                automatically. Add or remove steps below.
              </Fragment>
            )
            : (
              <Fragment>
                Build the page from sections. Add one below, edit it, and drag the <span class="grip-inline">⠿</span>
                handle to reorder. It saves automatically.
              </Fragment>
            )}
      </p>

      <ol class="sections" id="composer" role="list"></ol>

      {showPalette && (
        <div class="palette">
          <span class="palette-label">Add a section</span>
          <div id="palette" class="palette-btns"></div>
        </div>
      )}
    </section>

    <section class="pane pane--preview">
      <div class="preview__bar">
        <span class="muted">Live preview <span class="muted">(draft — not public until you publish)</span></span>
        <a href={page.path} target="_blank" rel="noopener">Open live page ↗</a>
      </div>
      <iframe id="preview" src={previewSrc} title={`Preview of ${page.name}`}></iframe>
    </section>
  </div>

  <style>
    .hint { margin: 0 0 1.5rem; font-size: 0.92rem; }
    .grip-inline { color: var(--muted); }

    .sections { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.85rem; }

    /* palette */
    .palette { border: 1px dashed var(--line); border-radius: var(--radius); padding: 1rem; text-align: center; }
    .palette-label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--muted); margin-bottom: 0.6rem; }
    .palette-btns { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
    .palette-btns .btn { flex: 0 0 auto; }
  </style>

  <!-- The block cards are built at runtime (innerHTML), so they never receive
       Astro's scope attribute — these card-internal rules must be global. No
       other element on this admin route uses these class names. -->
  <style is:global>
    .pane--edit .mini { display: block; font-weight: 600; font-size: 0.78rem; color: var(--muted); margin: 0.6rem 0 0.25rem; }

    /* rich-text control (bold / italic / link) */
    .pane--edit .rt { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: #fff; }
    .pane--edit .rt:focus-within { outline: 2px solid var(--brand); border-color: var(--brand); }
    .pane--edit .rt-toolbar { display: flex; gap: 0.15rem; padding: 0.25rem; border-bottom: 1px solid var(--line); background: #f7f8fa; }
    .pane--edit .rt-toolbar button { font: inherit; font-size: 0.85rem; min-width: 2.25rem; min-height: 2rem; padding: 0.25rem 0.55rem; border: 1px solid transparent; background: transparent; border-radius: 5px; cursor: pointer; color: var(--ink); }
    .pane--edit .rt-toolbar button[aria-pressed='true'] { background: var(--control-active); color: var(--brand-deep); }
    .pane--edit .rt-toolbar button:hover { background: #e6e8ee; }
    .pane--edit .rt-editor { min-height: 3.5rem; padding: 0.55rem 0.65rem; font: inherit; outline: none; }
    .pane--edit .rt-editor:empty::before { content: 'Write here…'; color: #aab0bb; }
    .pane--edit .rt-editor a { color: var(--brand-deep); text-decoration: underline; }

    .pane--edit .section { background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--brand); border-radius: var(--radius); padding: 0.85rem 0.95rem; box-shadow: var(--shadow); }
    .pane--edit .section.dragging { opacity: 0.5; }
    .pane--edit .section.confirming { border-color: #d99; background: #fdf3f3; }
    .pane--edit .section__head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem; }
    .pane--edit .head-spacer { flex: 1; }
    .pane--edit .grip { cursor: grab; background: var(--line); border: 0; color: var(--grip-fg); font-size: 1.05rem; line-height: 1; padding: 0.25rem 0.5rem; border-radius: 6px; }
    .pane--edit .grip:hover { background: #d7dae1; }
    .pane--edit .grip:active { cursor: grabbing; }
    .pane--edit .moveb { min-width: 1.9rem; min-height: 1.9rem; border: 1px solid var(--line); background: #fff; color: var(--grip-fg); font-size: 0.95rem; line-height: 1; border-radius: 6px; cursor: pointer; }
    .pane--edit .moveb:hover { background: var(--control-active); color: var(--brand-deep); }
    .pane--edit .moveb:disabled { opacity: 0.3; cursor: default; }
    .pane--edit .moveb:disabled:hover { background: #fff; color: var(--grip-fg); }
    .pane--edit .zz-num { font-family: Montserrat, sans-serif; font-weight: 700; font-size: 0.85rem; color: var(--brand-deep); }
    .pane--edit .rev { display: flex; align-items: center; gap: 0.3rem; font-size: 0.8rem; color: var(--muted); margin-top: 0.6rem; }
    .pane--edit .rev input { width: auto; }
    .pane--edit .kind { font: inherit; font-size: 0.85rem; padding: 0.25rem 0.4rem; border: 1px solid var(--line); border-radius: 6px; background: #fff; }
    .pane--edit .field { width: 100%; font: inherit; border: 1px solid var(--line); border-radius: 8px; padding: 0.55rem 0.65rem; background: #fff; }
    .pane--edit .field:focus { outline: 2px solid var(--brand); border-color: var(--brand); }
    .pane--edit .zz-image { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.35rem; }
    .pane--edit .zz-thumb { width: 96px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); background: #f0f1f4; }
    .pane--edit .zz-upmsg { font-size: 0.8rem; }
    .pane--edit .confirm { display: flex; gap: 0.5rem; align-items: center; font-size: 0.85rem; color: var(--danger); font-weight: 600; }
    .pane--edit .confirm button { font: inherit; font-weight: 600; cursor: pointer; border-radius: 6px; padding: 0.25rem 0.6rem; border: 1px solid var(--line); background: #fff; }
    .pane--edit .confirm .yes { background: var(--danger-bg); color: var(--danger); border-color: #e3b3b3; }

    /* repeater (a list of sub-item cards inside one block) */
    .pane--edit .rep { display: grid; gap: 0.6rem; margin: 0.35rem 0 0.6rem; }
    .pane--edit .rep-item { border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 8px; padding: 0.6rem 0.7rem; background: #fbfbfc; }
    .pane--edit .rep-item.confirming { border-color: #d99; background: #fdf3f3; }
    .pane--edit .rep-head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.2rem; }
    .pane--edit .rep-grip { cursor: grab; background: var(--line); border: 0; color: var(--grip-fg); font-size: 1rem; line-height: 1; padding: 0.15rem 0.45rem; border-radius: 6px; }
    .pane--edit .rep-grip:hover { background: #d7dae1; }
    .pane--edit .rep-grip:active { cursor: grabbing; }
    .pane--edit .rep-add { width: 100%; }
  </style>

  <script src="/assets/sortable.min.js" is:inline></script>
  <script>
    import { initRichText } from '../../../lib/rich-text-client';
    initRichText();
  </script>
  <script is:inline define:vars={{ pageKey: page.key, slot: page.slot, config, blocks }}>
    const saveEl = document.getElementById('save');
    const errbar = document.getElementById('errbar');
    const preview = document.getElementById('preview');
    const publishBtn = document.getElementById('publish');
    const livenote = document.getElementById('livenote');
    let timer, lastSave = null, flushSave = null;

    // Keep the preview clean: hide the cookie banner + Astro dev toolbar inside it.
    preview.addEventListener('load', () => {
      try {
        const doc = preview.contentDocument;
        const s = doc.createElement('style');
        s.textContent = '#consent, astro-dev-toolbar { display: none !important; }';
        doc.head.appendChild(s);
      } catch {}
    });

    function setState(s) {
      saveEl.dataset.state = s;
      saveEl.textContent = s === 'saving' ? 'Saving…' : s === 'error' ? 'Not saved' : 'Saved';
    }
    function showError() { errbar.hidden = false; }
    function hideError() { errbar.hidden = true; }
    function markPending(p) {
      publishBtn.disabled = !p;
      livenote.dataset.pending = String(p);
      livenote.textContent = p
        ? 'You have unpublished changes. Click “Publish changes” to put them on the live site.'
        : 'This page is up to date with the live site.';
    }

    async function postBlocks(payload) {
      setState('saving');
      lastSave = () => postBlocks(payload);
      try {
        const res = await fetch('/api/admin/blocks', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ page: pageKey, slot, blocks: payload }),
        });
        const ok = (await res.json()).ok;
        if (ok) { setState('saved'); hideError(); markPending(true); return true; }
        setState('error'); showError(); return false;
      } catch { setState('error'); showError(); return false; }
    }
    function schedule(fn) { clearTimeout(timer); timer = setTimeout(fn, 700); }

    // Shared image-upload wiring. Opens the file dialog on the "Upload image…"
    // button and POSTs the file to be resized; the returned manifest is written
    // into the field's hidden input — a `.zz-imgval` (JSON ZigImage, for <picture>
    // fields) and/or a `.zz-bgval` (a CSS url(), for background-image fields).
    // `onDone` runs on success (a save+reload, since adding an image is structural).
    function wireUpload(list, onDone) {
      list.addEventListener('click', (e) => {
        if (e.target.matches('.zz-upload')) e.target.closest('.zz-image').querySelector('.zz-file').click();
      });
      list.addEventListener('change', async (e) => {
        if (!e.target.matches('.zz-file') || !e.target.files[0]) return;
        const wrap = e.target.closest('.zz-image');
        const msg = wrap.querySelector('.zz-upmsg');
        msg.textContent = 'Resizing…';
        const fd = new FormData(); fd.append('file', e.target.files[0]);
        try {
          const res = await fetch('/api/admin/upload', { method: 'POST', body: fd });
          const d = await res.json();
          if (d.ok) {
            const jsonEl = wrap.querySelector('.zz-imgval'); if (jsonEl) jsonEl.value = JSON.stringify(d.img);
            const bgEl = wrap.querySelector('.zz-bgval'); if (bgEl) bgEl.value = `url('${d.img.jpg}')`;
            const t = wrap.querySelector('.zz-thumb'); t.src = d.img.jpg; t.hidden = false;
            msg.textContent = '';
            onDone();
          } else msg.textContent = d.error || 'Upload failed';
        } catch { msg.textContent = 'Upload failed'; }
        e.target.value = '';
      });
    }

    document.getElementById('retry').addEventListener('click', () => { if (lastSave) lastSave(); });
    publishBtn.addEventListener('click', async () => {
      publishBtn.disabled = true; publishBtn.textContent = 'Publishing…';
      try {
        clearTimeout(timer);            // cancel any pending autosave so it can't re-flag pending…
        if (flushSave) await flushSave(); // …and flush the latest edit into the draft first
        const res = await fetch('/api/admin/publish', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ page: pageKey, slot }),
        });
        publishBtn.textContent = 'Publish changes';
        const ok = (await res.json()).ok;
        markPending(!ok);
        if (ok) hideError(); else showError();
      } catch { publishBtn.textContent = 'Publish changes'; markPending(true); showError(); }
    });

    // (Rich text is handled by Lexical — see lib/rich-text-client. It writes
    // serialized HTML into the hidden .rt-value inputs and fires `input` events.)

    // Inline "Remove → are you sure?" so a misclick can't delete content. Works
    // for both a block card (.section__head) and a repeater item (.rep-head).
    function confirmRemove(li, onYes) {
      const head = li.querySelector('.section__head') ?? li.querySelector('.rep-head');
      const btn = head.querySelector('[data-remove]') ?? head.querySelector('[data-rep-remove]');
      btn.style.display = 'none';
      li.classList.add('confirming');
      const wrap = document.createElement('span');
      wrap.className = 'confirm';
      wrap.innerHTML = 'Delete this? <button type="button" class="yes">Delete</button><button type="button" class="no">Keep</button>';
      head.appendChild(wrap);
      wrap.querySelector('.no').addEventListener('click', () => { wrap.remove(); btn.style.display = ''; li.classList.remove('confirming'); });
      wrap.querySelector('.yes').addEventListener('click', () => { onYes(); });
    }

    // ---- The composer engine: a page is a list of typed component blocks ----
    const list = document.getElementById('composer');
    const SPECS = {
      hero: { label: 'Hero', fields: [
        { n: 'lead', t: 'plain', l: 'Small line above the title' },
        { n: 'heading', t: 'plain', l: 'Title' },
        { n: 'intro', t: 'rich', l: 'Intro text' },
      ] },
      heading: { label: 'Heading', fields: [{ n: 'text', t: 'plain', l: 'Heading' }] },
      text: { label: 'Text', fields: [{ n: 'html', t: 'rich', l: 'Text' }] },
      imageText: { label: 'Image + text', fields: [
        { n: 'reverse', t: 'toggle', l: 'Image on right' },
        { n: 'heading', t: 'plain', l: 'Heading' },
        { n: 'body', t: 'rich', l: 'Text' },
        { n: 'img', t: 'image', l: 'Image' },
      ] },
      cta: { label: 'Call to action', fields: [
        { n: 'heading', t: 'plain', l: 'Heading' },
        { n: 'body', t: 'rich', l: 'Text' },
        { n: 'label', t: 'plain', l: 'Button label' },
        { n: 'href', t: 'plain', l: 'Button link' },
      ] },
      banner: { label: 'Banner', fields: [
        { n: 'heading', t: 'plain', l: 'Heading' },
        { n: 'body', t: 'rich', l: 'Text' },
        { n: 'shorten', t: 'toggle', l: 'Narrow band' },
      ] },
      valueCards: { label: 'Value cards', fields: [
        { n: 'heading', t: 'plain', l: 'Section heading' },
        { n: 'cards', t: 'repeater', l: 'Cards', addLabel: 'card', item: [
          { n: 'img', t: 'image', l: 'Icon' },
          { n: 'title', t: 'plain', l: 'Title' },
          { n: 'text', t: 'rich', l: 'Text' },
          { n: 'style', t: 'select', l: 'Colour', opts: [['navy', 'Navy'], ['darknavy', 'Dark navy'], ['pink', 'Pink'], ['lightpink', 'Light pink']] },
        ] },
      ] },
      imageBlock: { label: 'Large image + text', fields: [
        { n: 'img', t: 'image', l: 'Image' },
        { n: 'heading', t: 'plain', l: 'Heading' },
        { n: 'body', t: 'rich', l: 'Text' },
      ] },
      team: { label: 'Team', fields: [
        { n: 'heading', t: 'plain', l: 'Section heading' },
        { n: 'members', t: 'repeater', l: 'Team members', addLabel: 'member', item: [
          { n: 'bg', t: 'bgimage', l: 'Photo' },
          { n: 'name', t: 'plain', l: 'Name' },
          { n: 'role', t: 'plain', l: 'Role' },
        ] },
        { n: 'label', t: 'plain', l: 'Button label' },
        { n: 'href', t: 'plain', l: 'Button link' },
      ] },
      testimonials: { label: 'Testimonials', fields: [
        { n: 'items', t: 'repeater', l: 'Quotes', addLabel: 'quote', item: [
          { n: 'quote', t: 'plain', l: 'Quote' },
          { n: 'author', t: 'plain', l: 'Name' },
          { n: 'role', t: 'plain', l: 'Role' },
        ] },
      ] },
      logos: { label: 'Logos', fields: [
        { n: 'heading', t: 'plain', l: 'Section heading' },
        { n: 'logos', t: 'repeater', l: 'Logos', addLabel: 'logo', item: [
          { n: 'img', t: 'image', l: 'Logo' },
        ] },
      ] },
      heroForm: { label: 'Hero with form', fields: [
        { n: 'heading', t: 'plain', l: 'Title' },
        { n: 'intro', t: 'rich', l: 'Intro text' },
      ] },
      steps: { label: 'How it works (steps)', fields: [
        { n: 'heading', t: 'plain', l: 'Section heading' },
        { n: 'steps', t: 'repeater', l: 'Steps', addLabel: 'step', item: [
          { n: 'reverse', t: 'toggle', l: 'Image on right' },
          { n: 'heading', t: 'plain', l: 'Step title' },
          { n: 'body', t: 'rich', l: 'Step description' },
          { n: 'img', t: 'image', l: 'Image' },
        ] },
      ] },
      largeList: { label: 'Large list', fields: [
        { n: 'heading', t: 'plain', l: 'Section heading' },
        { n: 'items', t: 'repeater', l: 'List items', addLabel: 'item', item: [
          { n: 'heading', t: 'plain', l: 'Term' },
          { n: 'text', t: 'plain', l: 'Description' },
        ] },
        { n: 'label', t: 'plain', l: 'Button label' },
        { n: 'href', t: 'plain', l: 'Button link' },
      ] },
      safety: { label: 'Support & safety', fields: [
        { n: 'content', t: 'rich', l: 'Intro' },
        { n: 'cards', t: 'repeater', l: 'Support cards', addLabel: 'card', item: [
          { n: 'text', t: 'rich', l: 'Text' },
        ] },
        { n: 'important', t: 'rich', l: 'Callout' },
      ] },
      textBlock: { label: 'Long-form text', fields: [
        { n: 'heading', t: 'plain', l: 'Heading' },
        { n: 'body', t: 'rich', l: 'Body' },
      ] },
      faqs: { label: 'FAQ accordion', fields: [
        { n: 'heading', t: 'plain', l: 'Section heading' },
        { n: 'items', t: 'repeater', l: 'Questions', addLabel: 'question', item: [
          { n: 'q', t: 'plain', l: 'Question' },
          { n: 'a', t: 'rich', l: 'Answer' },
        ] },
      ] },
      contactHero: { label: 'Contact hero', fields: [
        { n: 'heading', t: 'plain', l: 'Title' },
        { n: 'description', t: 'rich', l: 'Intro (optional)' },
        { n: 'phone', t: 'plain', l: 'Phone' },
        { n: 'email', t: 'plain', l: 'Email' },
        { n: 'address', t: 'rich', l: 'Address' },
      ] },
      map: { label: 'Map', fields: [
        { n: 'embed', t: 'plain', l: 'Google Maps embed URL' },
      ] },
      eventSection: { label: 'Booking (Calendly)', fields: [
        { n: 'eyebrow', t: 'plain', l: 'Eyebrow' },
        { n: 'heading', t: 'plain', l: 'Heading' },
        { n: 'body', t: 'rich', l: 'Text' },
        { n: 'calendlyUrl', t: 'plain', l: 'Calendly URL' },
      ] },
      richSection: { label: 'Custom section', fields: [
        { n: 'body', t: 'rich', l: 'Content' },
      ] },
      homeHero: { label: 'Home hero', fields: [
        { n: 'heading', t: 'plain', l: 'Title' },
        { n: 'intro', t: 'rich', l: 'Intro' },
        { n: 'featureHeading', t: 'plain', l: 'Feature heading' },
        { n: 'featureBody', t: 'rich', l: 'Feature text' },
      ] },
    };
    const DEFAULTS = {
      hero: { lead: '', heading: 'New heading', intro: '<p></p>', bg: '' },
      heading: { text: 'Section title' },
      text: { html: '<p>Write something…</p>' },
      imageText: { reverse: false, heading: 'New section', body: '<p></p>', img: {} },
      cta: { heading: 'Ready to get started?', body: '<p></p>', label: 'Get started', href: '/contact-us' },
      banner: { heading: 'New heading', body: '<p></p>', shorten: true },
      valueCards: { heading: 'Our Values', cards: [{ img: {}, title: 'Title', text: '<p></p>', style: 'navy' }] },
      imageBlock: { img: {}, heading: 'New heading', body: '<p></p>' },
      team: { heading: 'Our Team', members: [{ bg: '', name: 'Name', role: 'Role' }], label: '', href: '' },
      testimonials: { items: [{ quote: '', author: 'Name', role: 'Role' }] },
      logos: { heading: 'Referral Partners', logos: [{ img: {} }] },
      heroForm: { heading: 'New heading', intro: '<p></p>', bg: '' },
      steps: { heading: 'How it Works', steps: [{ reverse: false, heading: 'Step', body: '<p></p>', img: {} }] },
      largeList: { heading: 'Section heading', items: [{ heading: 'Term', text: 'Description' }], label: '', href: '' },
      safety: { content: '<p></p>', cards: [{ text: '<p></p>' }], important: '<p></p>' },
      textBlock: { heading: 'New heading', body: '<p></p>' },
      faqs: { heading: 'Frequently Asked Questions', items: [{ q: 'Question?', a: '<p></p>' }] },
      contactHero: { heading: 'Contact Us', description: '', phone: '', email: '', address: '<p></p>', bg: '' },
      map: { embed: '' },
      eventSection: { eyebrow: 'Start Here.', heading: 'Book a call', body: '<p></p>', calendlyUrl: '' },
      richSection: { sectionClass: 'editor-content', body: '<p></p>' },
      homeHero: { heading: 'New heading', intro: '<p></p>', featureHeading: '', featureBody: '<p></p>' },
    };
    // Default value for a freshly-added repeater sub-field.
    const subDefault = (sf) => sf.t === 'image' ? {} : sf.t === 'toggle' ? false : sf.t === 'rich' ? '<p></p>' : sf.t === 'select' ? (sf.opts[0] ? sf.opts[0][0] : '') : '';
    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const bgUrl = (v) => { const m = /url\(['"]?([^'")]+)/.exec(v || ''); return m ? m[1] : ''; };
    // Render one field's editor UI. `attr` is the data-attribute the value input
    // carries — 'data-field' for a block's own fields, 'data-subfield' for a field
    // nested inside a repeater item (so the two never collide when we collect).
    function fieldHtml(f, v, attr = 'data-field') {
      if (f.t === 'plain') return `<label class="mini">${f.l}</label><input class="field" ${attr}="${f.n}" value="${esc(v)}">`;
      if (f.t === 'rich') return `<label class="mini">${f.l}</label><div class="rt" data-rt-label="${esc(f.l)}"><div class="rt-toolbar" role="toolbar" aria-label="Text formatting"><button type="button" data-rt="bold" aria-label="Bold" aria-pressed="false"><b>B</b></button><button type="button" data-rt="italic" aria-label="Italic" aria-pressed="false"><i>I</i></button><button type="button" data-rt="link" aria-label="Add link">Link</button></div><div class="rt-editor"></div><input type="hidden" class="rt-value" ${attr}="${f.n}" value="${esc(v)}"></div>`;
      if (f.t === 'toggle') return `<label class="rev"><input type="checkbox" ${attr}="${f.n}" ${v ? 'checked' : ''}> ${f.l}</label>`;
      if (f.t === 'select') return `<label class="mini">${f.l}</label><select class="kind" ${attr}="${f.n}">${f.opts.map((o) => `<option value="${o[0]}" ${v === o[0] ? 'selected' : ''}>${o[1]}</option>`).join('')}</select>`;
      if (f.t === 'image') { const thumb = (v && (v.src || v.jpg)) || ''; return `<label class="mini">${f.l}</label><div class="zz-image"><img class="zz-thumb" src="${esc(thumb)}" alt="" ${thumb ? '' : 'hidden'}><input type="hidden" class="zz-imgval" ${attr}="${f.n}" value="${esc(JSON.stringify(v || {}))}"><button type="button" class="btn btn--ghost zz-upload">Upload image…</button><span class="zz-upmsg muted"></span><input type="file" class="zz-file" accept="image/jpeg,image/png" hidden></div>`; }
      if (f.t === 'bgimage') { const thumb = bgUrl(v); return `<label class="mini">${f.l}</label><div class="zz-image"><img class="zz-thumb" src="${esc(thumb)}" alt="" ${thumb ? '' : 'hidden'}><input type="hidden" class="zz-bgval" ${attr}="${f.n}" value="${esc(v || '')}"><button type="button" class="btn btn--ghost zz-upload">Upload image…</button><span class="zz-upmsg muted"></span><input type="file" class="zz-file" accept="image/jpeg,image/png" hidden></div>`; }
      if (f.t === 'repeater') {
        const items = Array.isArray(v) ? v : [];
        return `<label class="mini">${f.l}</label><div class="rep" data-rep="${f.n}">${items.map((it) => repeaterItemHtml(f, it)).join('')}</div><button type="button" class="btn btn--ghost rep-add" data-rep-add="${f.n}">+ Add ${f.addLabel || 'item'}</button>`;
      }
      return '';
    }
    // One repeater item card: a drag/remove head + its sub-fields (which use
    // data-subfield so a block's own collect() never picks them up).
    function repeaterItemHtml(f, data) {
      const sub = f.item.map((sf) => fieldHtml(sf, data ? data[sf.n] : undefined, 'data-subfield')).join('');
      return `<div class="rep-item" data-rep-item><div class="rep-head"><button type="button" class="rep-grip" title="Drag to reorder" aria-hidden="true" tabindex="-1">⠿</button><button type="button" class="moveb" data-rep-move="up" aria-label="Move up">↑</button><button type="button" class="moveb" data-rep-move="down" aria-label="Move down">↓</button><span class="head-spacer"></span><button type="button" class="btn btn--quiet" data-rep-remove>Remove</button></div>${sub}</div>`;
    }
    function makeCard(kind, data) {
      const li = document.createElement('li');
      li.className = 'section'; li.setAttribute('data-block', ''); li.dataset.kind = kind;
      li.dataset.extra = JSON.stringify(data);
      const fields = SPECS[kind].fields.map((f) => fieldHtml(f, data[f.n])).join('');
      if (config.single) {
        li.innerHTML = fields; // single fixed block (e.g. hero): no header / drag / remove
      } else {
        const label = config.numbered ? 'Step' : SPECS[kind].label;
        li.innerHTML = `<div class="section__head"><button type="button" class="grip" title="Drag to reorder" aria-hidden="true" tabindex="-1">⠿</button><button type="button" class="moveb" data-move="up" aria-label="Move up">↑</button><button type="button" class="moveb" data-move="down" aria-label="Move down">↓</button><span class="zz-num">${label}</span><span class="head-spacer"></span><button type="button" class="btn btn--quiet" data-remove>Remove</button></div>${fields}`;
      }
      return li;
    }
    const cards = () => [...list.querySelectorAll('[data-block]')];
    function renumber() {
      if (!config.numbered) return;
      cards().forEach((li, i) => { const n = li.querySelector('.zz-num'); if (n) n.textContent = 'Step ' + (i + 1); });
    }
    // Read one field's value off its input (plain/rich/select/bgimage → string,
    // toggle → bool, image → parsed ZigImage). `sel` is data-field or data-subfield.
    function readField(scope, f, sel) {
      const el = scope.querySelector(`[${sel}="${f.n}"]`);
      if (!el) return undefined;
      if (f.t === 'toggle') return el.checked;
      if (f.t === 'image') { try { return JSON.parse(el.value || '{}'); } catch { return {}; } }
      return el.value;
    }
    function collectRepeater(li, f) {
      const wrap = li.querySelector(`[data-rep="${f.n}"]`);
      if (!wrap) return [];
      return [...wrap.querySelectorAll(':scope > [data-rep-item]')].map((item) => {
        const obj = {};
        for (const sf of f.item) { const val = readField(item, sf, 'data-subfield'); if (val !== undefined) obj[sf.n] = val; }
        return obj;
      });
    }
    function collect() {
      return cards().map((li) => {
        const kind = li.dataset.kind;
        let body = {};
        try { body = JSON.parse(li.dataset.extra || '{}'); } catch {}
        for (const f of SPECS[kind].fields) {
          if (f.t === 'repeater') { body[f.n] = collectRepeater(li, f); continue; }
          const val = readField(li, f, 'data-field');
          if (val !== undefined) body[f.n] = val;
        }
        return { kind, body: JSON.stringify(body) };
      });
    }
    const save = () => postBlocks(collect());
    flushSave = save;
    const saveAndReload = () => { setState('saving'); clearTimeout(timer); timer = setTimeout(async () => { if (await save()) preview.contentWindow.location.reload(); }, 350); };

    // Patch a single field into the preview in place. Returns false if the preview
    // has no matching node yet (e.g. a just-added block) — caller falls back to a reload.
    function liveText(li, name) {
      const i = cards().indexOf(li);
      const doc = preview.contentDocument;
      const block = doc && doc.querySelector(`[data-cms-block="${i}"]`);
      const target = block && block.querySelector(`[data-cms-field="${name}"]`);
      const src = li.querySelector(`[data-field="${name}"]`);
      if (!target || !src) return false;
      const f = SPECS[li.dataset.kind].fields.find((x) => x.n === name);
      if (f && f.t === 'rich') target.innerHTML = src.value; else target.textContent = src.value;
      return true;
    }

    // Same as liveText, but for a text field inside a repeater item — addressed in
    // the preview by [data-cms-item="i"] within the block. Returns false (→ reload)
    // for non-text sub-fields or when the preview node isn't there yet.
    function liveSubText(li, subEl) {
      const name = subEl.getAttribute('data-subfield');
      const repItem = subEl.closest('[data-rep-item]'); if (!repItem) return false;
      const repWrap = repItem.closest('[data-rep]'); if (!repWrap) return false;
      const f = SPECS[li.dataset.kind].fields.find((x) => x.n === repWrap.getAttribute('data-rep'));
      const sf = f && f.item.find((x) => x.n === name);
      if (!sf || (sf.t !== 'plain' && sf.t !== 'rich')) return false;
      const itemIdx = [...repWrap.querySelectorAll(':scope > [data-rep-item]')].indexOf(repItem);
      const b = cards().indexOf(li);
      const doc = preview.contentDocument;
      const block = doc && doc.querySelector(`[data-cms-block="${b}"]`);
      const itemEl = block && block.querySelector(`[data-cms-item="${itemIdx}"]`);
      const target = itemEl && itemEl.querySelector(`[data-cms-field="${name}"]`);
      if (!target) return false;
      if (sf.t === 'rich') target.innerHTML = subEl.value; else target.textContent = subEl.value;
      return true;
    }

    list.addEventListener('input', (e) => {
      const li = e.target.closest('[data-block]'); if (!li) return;
      setState('saving');
      const subEl = e.target.closest('[data-subfield]');
      if (subEl) { if (liveSubText(li, subEl)) schedule(save); else schedule(saveAndReload); return; }
      const fieldEl = e.target.closest('[data-field]'); if (!fieldEl) return;
      const name = fieldEl.getAttribute('data-field');
      const f = SPECS[li.dataset.kind].fields.find((x) => x.n === name);
      if (f && (f.t === 'plain' || f.t === 'rich')) {
        if (liveText(li, name)) schedule(save); else schedule(saveAndReload);
      } else schedule(saveAndReload); // toggle / select change the layout → reload
    });
    wireUpload(list, saveAndReload);

    // Repeater item drag-reorder — one Sortable per repeater container, set up lazily.
    const repSortables = new WeakSet();
    function ensureRepSortable(wrap) {
      if (!window.Sortable || repSortables.has(wrap)) return;
      repSortables.add(wrap);
      new Sortable(wrap, { handle: '.rep-grip', animation: 150, ghostClass: 'dragging', onEnd: () => { saveAndReload(); syncMoveButtons(); } });
    }
    const initRepSortables = (scope) => scope.querySelectorAll('[data-rep]').forEach(ensureRepSortable);

    // Keyboard-accessible reorder (the drag grip is mouse-only): move a block or
    // a repeater item past its same-type sibling.
    function moveEl(el, dir, match) {
      const sib = dir === 'up' ? el.previousElementSibling : el.nextElementSibling;
      if (!sib || !sib.matches(match)) return false;
      if (dir === 'up') el.parentNode.insertBefore(el, sib); else el.parentNode.insertBefore(sib, el);
      return true;
    }
    // Disable the ↑ of the first / ↓ of the last item so the edge buttons aren't
    // focusable no-ops. Runs after every add/remove/reorder.
    function syncMoveButtons() {
      const blocks = cards();
      blocks.forEach((li, i) => {
        const up = li.querySelector('.section__head [data-move="up"]');
        const down = li.querySelector('.section__head [data-move="down"]');
        if (up) up.disabled = i === 0;
        if (down) down.disabled = i === blocks.length - 1;
      });
      for (const wrap of list.querySelectorAll('[data-rep]')) {
        const items = [...wrap.querySelectorAll(':scope > [data-rep-item]')];
        items.forEach((item, i) => {
          const up = item.querySelector('.rep-head [data-rep-move="up"]');
          const down = item.querySelector('.rep-head [data-rep-move="down"]');
          if (up) up.disabled = i === 0;
          if (down) down.disabled = i === items.length - 1;
        });
      }
    }
    // After a move, keep focus on a still-enabled move button of the same item.
    function refocusMove(el, btn) {
      if (!btn.disabled) { btn.focus(); return; }
      const alt = el.querySelector((btn.matches('[data-move]') ? '[data-move]' : '[data-rep-move]') + ':not([disabled])');
      if (alt) alt.focus();
    }
    list.addEventListener('click', (e) => {
      if (e.target.matches('[data-move]')) {
        const li = e.target.closest('[data-block]');
        if (moveEl(li, e.target.getAttribute('data-move'), '[data-block]')) { renumber(); syncMoveButtons(); saveAndReload(); refocusMove(li, e.target); }
        return;
      }
      if (e.target.matches('[data-rep-move]')) {
        const item = e.target.closest('[data-rep-item]');
        if (moveEl(item, e.target.getAttribute('data-rep-move'), '[data-rep-item]')) { syncMoveButtons(); saveAndReload(); refocusMove(item, e.target); }
        return;
      }
      if (e.target.matches('[data-remove]')) { const li = e.target.closest('[data-block]'); confirmRemove(li, () => { li.remove(); renumber(); syncMoveButtons(); saveAndReload(); }); return; }
      if (e.target.matches('[data-rep-remove]')) { const item = e.target.closest('[data-rep-item]'); confirmRemove(item, () => { item.remove(); syncMoveButtons(); saveAndReload(); }); return; }
      if (e.target.matches('[data-rep-add]')) {
        const li = e.target.closest('[data-block]');
        const f = SPECS[li.dataset.kind].fields.find((x) => x.n === e.target.getAttribute('data-rep-add'));
        const wrap = li.querySelector(`[data-rep="${f.n}"]`);
        const def = {}; for (const sf of f.item) def[sf.n] = subDefault(sf);
        const tmp = document.createElement('div'); tmp.innerHTML = repeaterItemHtml(f, def);
        const node = tmp.firstElementChild; wrap.appendChild(node);
        ensureRepSortable(wrap); syncMoveButtons();
        const first = node.querySelector('[data-subfield]'); if (first && first.focus) first.focus();
        saveAndReload();
      }
    });
    list.addEventListener('focusin', (e) => {
      const li = e.target.closest('[data-block]'); if (!li) return;
      const i = cards().indexOf(li);
      const doc = preview.contentDocument; const block = doc && doc.querySelector(`[data-cms-block="${i}"]`);
      if (block) block.scrollIntoView({ block: 'center', behavior: 'smooth' });
    });
    if (!config.single && window.Sortable) new Sortable(list, { handle: '.grip', animation: 150, ghostClass: 'dragging', onEnd: () => { renumber(); syncMoveButtons(); saveAndReload(); } });

    const paletteEl = document.getElementById('palette');
    if (paletteEl) {
      for (const kind of config.palette) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn btn--ghost';
        b.textContent = '+ ' + (config.addLabel || SPECS[kind].label);
        b.addEventListener('click', () => {
          const li = makeCard(kind, JSON.parse(JSON.stringify(DEFAULTS[kind])));
          list.appendChild(li); renumber(); initRepSortables(li); syncMoveButtons();
          const first = li.querySelector('[data-field], [data-subfield]'); if (first && first.focus) first.focus();
          saveAndReload();
        });
        paletteEl.appendChild(b);
      }
    }

    for (const blk of blocks) {
      let data = {}; try { data = JSON.parse(blk.body); } catch {}
      list.appendChild(makeCard(blk.kind, data));
    }
    if (config.single && cards().length === 0) {
      list.appendChild(makeCard(config.single, JSON.parse(JSON.stringify(DEFAULTS[config.single]))));
    }
    renumber();
    initRepSortables(list);
    syncMoveButtons();
  </script>
</AdminLayout>
