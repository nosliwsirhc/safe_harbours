---
// The admin login. Self-contained (no public theme) — it's a tool page.
export const prerender = false;
const failed = Astro.url.searchParams.get('e') === '1';
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in · Safe Harbours admin</title>
    <style>
      :root { color-scheme: light; }

      body { font: 16px/1.5 system-ui, sans-serif; background: #f4f5f7; margin: 0;
        min-height: 100dvh; display: grid; place-items: center; color: #1f2430; }

      form { background: #fff; padding: 2rem; border-radius: 12px; width: min(360px, 90vw);
        box-shadow: 0 8px 30px rgb(0 0 0 / 8%); }
      h1 { font-size: 1.25rem; margin: 0 0 1rem; }
      label { display: block; font-weight: 600; font-size: .85rem; margin-bottom: .35rem; }

      input { width: 100%; padding: .6rem .7rem; border: 1px solid #cdd2dc; border-radius: 8px;
        font: inherit; box-sizing: border-box; }

      button { margin-top: 1rem; width: 100%; padding: .65rem; border: 0; border-radius: 8px;
        background: #484e5e; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }

      .err { background: #fde8e8; color: #9b1c1c; padding: .6rem .7rem; border-radius: 8px;
        font-size: .85rem; margin-bottom: 1rem; }
    </style>
  </head>
  <body>
    <form method="POST" action="/api/admin/login">
      <h1>Safe Harbours admin</h1>
      {failed && <p class="err">Incorrect password. Try again.</p>}
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" autofocus required />
      <button type="submit">Sign in</button>
    </form>
  </body>
</html>
