---
// Manage DB-driven redirects: list existing ones and add/remove them. Both writes
// go through the hardened JSON endpoint /api/admin/redirects (same-origin target
// validation + cycle detection live there), so this page is just the UI.
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { isAuthed } from '../../../lib/admin';
import { listRedirects } from '../../../lib/redirects';

if (!(await isAuthed(Astro.request))) return Astro.redirect('/admin/login');

const redirects = await listRedirects();
---
<AdminLayout title="Redirects" active="redirects">
  <main class="wrap">
    <h1>Redirects</h1>
    <p class="lede muted">
      Send an old or retired web address to a new one. Both must be addresses on this site
      (starting with <code>/</code>). Use <strong>Permanent</strong> for a page that has moved
      for good, <strong>Temporary</strong> while a page is briefly elsewhere.
    </p>

    <form class="create" id="add-form">
      <h2 class="grouphead">Add a redirect</h2>
      <p class="formerr" id="add-error" role="alert" hidden></p>
      <div class="create-row">
        <label class="create-field">
          <span>From <span class="muted">(old address)</span></span>
          <input class="field" type="text" id="from" placeholder="/old-page" required />
        </label>
        <label class="create-field">
          <span>To <span class="muted">(new address)</span></span>
          <input class="field" type="text" id="to" placeholder="/new-page" required />
        </label>
        <label class="create-field create-field--narrow">
          <span>Type</span>
          <select class="field" id="status">
            <option value="301">Permanent</option>
            <option value="302">Temporary</option>
          </select>
        </label>
        <button type="submit" class="btn btn--primary" id="add-btn">Add</button>
      </div>
    </form>

    <h2 class="grouphead">Active redirects</h2>
    {redirects.length === 0 ? (
      <p class="empty muted">No redirects yet.</p>
    ) : (
      <table class="rtable">
        <thead>
          <tr><th scope="col">From</th><th scope="col">To</th><th scope="col">Type</th><th scope="col"><span class="vh">Actions</span></th></tr>
        </thead>
        <tbody>
          {redirects.map((r) => (
            <tr data-from={r.from}>
              <td><code>{r.from}</code></td>
              <td><code>{r.to}</code></td>
              <td>{r.status === 301 ? 'Permanent' : 'Temporary'}</td>
              <td class="row-actions"><button type="button" class="btn btn--quiet del-btn" data-from={r.from}>Remove</button></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </main>

  <style>
    .wrap { max-width: 820px; margin: 0 auto; padding: 2.5rem 1.5rem; }
    h1 { font-size: 1.6rem; margin: 0 0 0.5rem; }
    .lede { margin: 0 0 2rem; font-size: 0.95rem; max-width: 64ch; }
    .lede code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; }
    .grouphead { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin: 1.75rem 0 0.6rem; }

    .create { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.25rem; margin-bottom: 1rem; }
    .create .grouphead { margin-top: 0; }
    .create-row { display: grid; grid-template-columns: 1fr 1fr auto auto; gap: 0.75rem; align-items: end; }
    .create-field { display: grid; gap: 0.3rem; font-size: 0.85rem; font-weight: 600; }
    .create-field--narrow { min-width: 8rem; }
    .create-field .muted { font-weight: 400; }
    .field { width: 100%; font: inherit; border: 1px solid var(--line); border-radius: 8px; padding: 0.55rem 0.65rem; background: #fff; }
    .field:focus { outline: 2px solid var(--brand); border-color: var(--brand); }
    .formerr { color: var(--danger); background: var(--danger-bg); border-radius: 8px; padding: 0.5rem 0.75rem; font-size: 0.9rem; margin: 0 0 0.75rem; }
    .formerr[hidden] { display: none; }

    .rtable { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .rtable th, .rtable td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--line); }
    .rtable th { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
    .rtable code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.82rem; word-break: break-all; }
    .row-actions { text-align: right; }
    .del-btn { color: var(--danger); }
    .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

    @media (width <= 640px) { .create-row { grid-template-columns: 1fr; } }
  </style>

  <script is:inline>
    const form = document.getElementById('add-form');
    const errEl = document.getElementById('add-error');
    const showErr = (m) => { errEl.textContent = m; errEl.hidden = !m; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      showErr('');
      const btn = document.getElementById('add-btn');
      const from = document.getElementById('from').value.trim();
      const to = document.getElementById('to').value.trim();
      const status = Number(document.getElementById('status').value);
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/redirects', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ from, to, status }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) { window.location.reload(); return; }
        showErr(data.error || 'Could not add the redirect.');
      } catch { showErr('Could not reach the server. Please try again.'); }
      btn.disabled = false;
    });

    document.querySelectorAll('.del-btn').forEach((b) => {
      b.addEventListener('click', async () => {
        if (b.dataset.confirm !== '1') {
          b.dataset.confirm = '1'; b.textContent = 'Click again to remove';
          setTimeout(() => { b.dataset.confirm = ''; b.textContent = 'Remove'; }, 4000);
          return;
        }
        b.disabled = true;
        try {
          const res = await fetch('/api/admin/redirects', {
            method: 'DELETE', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ from: b.dataset.from }),
          });
          if ((await res.json()).ok) { window.location.reload(); return; }
        } catch {}
        b.disabled = false; b.textContent = 'Remove failed — retry';
      });
    });
  </script>
</AdminLayout>
