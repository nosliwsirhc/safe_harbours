---
// Settings: Google tag ids, marketing pixels, and per-form conversions. Rare setup
// task, kept off the main editing flow. Autosaves on change, in plain language.
// Pixel ids + event names + thank-you links are validated server-side before storage.
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAuthed } from '../../lib/admin';
import { getSettings } from '../../lib/content';
import { safeMarketingPixels, PIXEL_DEFS } from '../../lib/pixel-ids';
import { FORMS, safeFormConversions } from '../../lib/form-conversions';

if (!(await isAuthed(Astro.request))) return Astro.redirect('/admin/login');

const settings = await getSettings();
const pixels = safeMarketingPixels(settings.marketing_pixels);
const formConv = safeFormConversions(settings.form_conversions);
---
<AdminLayout title="Settings" active="settings">
  <main class="wrap">
    <div class="crumbs"><a href="/admin">← All pages</a><span class="save" id="save" data-state="saved" role="status" aria-live="polite">All changes saved</span></div>
    <h1>Tracking & analytics</h1>
    <p class="muted lede">Paste the IDs from each tool. They’re added to every page automatically. Leave a box empty to turn that one off.</p>
    <p class="formerr" id="err" role="alert" hidden></p>

    <label for="ga4">Google Analytics measurement ID</label>
    <input id="ga4" data-key="ga4_id" value={settings.ga4_id ?? ''} placeholder="G-XXXXXXXXXX" autocomplete="off" />
    <p class="muted small">Find it in Google Analytics → Admin → Data streams. Starts with “G-”.</p>

    <label for="gtm">Google Tag Manager container ID</label>
    <input id="gtm" data-key="gtm_id" value={settings.gtm_id ?? ''} placeholder="GTM-XXXXXXX" autocomplete="off" />
    <p class="muted small">Only if you use Tag Manager. Starts with “GTM-”.</p>

    <h2 class="section">Marketing pixels</h2>
    <p class="muted lede small-lede">
      For ad campaigns (Meta, TikTok, etc.). These only load after a visitor accepts cookies, so they
      respect consent. Paste just the ID — the tracking code is added for you.
    </p>
    {PIXEL_DEFS.map((p) => (
      <Fragment>
        <label for={`px-${p.type}`}>{p.label}</label>
        <input id={`px-${p.type}`} data-pixel={p.type} value={pixels[p.type] ?? ''} placeholder={p.placeholder} autocomplete="off" />
        <p class="muted small">{p.hint}</p>
      </Fragment>
    ))}

    <h2 class="section">Form conversions</h2>
    <p class="muted lede small-lede">
      What happens when someone submits each form. The <strong>event</strong> is sent to your analytics /
      Tag Manager (use it to count conversions); leave it blank for the default. The <strong>thank-you page</strong>
      is where they’re sent after submitting — a page on this site (e.g. <code>/thank-you-fostering</code>); leave
      blank to show the inline “thanks” message instead.
    </p>
    {FORMS.map((f) => (
      <div class="formrow">
        <span class="formrow__name">{f.label}</span>
        <div class="formrow__fields">
          <label class="fl">
            <span>Event name</span>
            <input data-form-event={f.key} value={formConv[f.key]?.event ?? ''} placeholder={f.defaultEvent} autocomplete="off" />
          </label>
          <label class="fl">
            <span>Thank-you page</span>
            <input data-form-thanks={f.key} value={formConv[f.key]?.thankYou ?? ''} placeholder="/thank-you-fostering" autocomplete="off" />
          </label>
        </div>
      </div>
    ))}
  </main>

  <style>
    .wrap { max-width: 620px; margin: 0 auto; padding: 2rem 1.5rem; }
    .crumbs { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
    .crumbs a { font-weight: 600; text-decoration: none; font-size: 0.9rem; }
    h1 { font-size: 1.5rem; margin: 0 0 0.3rem; }
    .section { font-size: 1.1rem; margin: 2.5rem 0 0.3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
    .lede { margin: 0 0 2rem; font-size: 1.02rem; }
    .small-lede { margin-bottom: 1.5rem; font-size: 0.92rem; }
    .small-lede code { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: 0.86em; }
    label { display: block; font-weight: 600; font-size: 0.9rem; margin: 1.25rem 0 0.4rem; }
    input { width: 100%; font: inherit; border: 1px solid var(--line); border-radius: 8px; padding: 0.6rem 0.7rem; background: #fff; }
    input:focus { outline: 2px solid var(--brand); border-color: var(--brand); }
    input[aria-invalid='true'] { border-color: var(--danger); outline-color: var(--danger); }
    .small { font-size: 0.84rem; margin: 0.35rem 0 0; }
    .formerr { color: var(--danger); background: var(--danger-bg); border-radius: 8px; padding: 0.5rem 0.75rem; font-size: 0.9rem; margin: 0 0 1rem; }
    .formerr[hidden] { display: none; }

    .formrow { padding: 1rem 0; border-bottom: 1px solid var(--line); }
    .formrow__name { font-weight: 600; font-size: 0.95rem; }
    .formrow__fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 0.5rem; }
    .formrow .fl { margin: 0; }
    .formrow .fl span { display: block; font-weight: 400; font-size: 0.8rem; color: var(--muted); margin-bottom: 0.25rem; }
    .formrow .fl input { margin: 0; }

    @media (width <= 560px) { .formrow__fields { grid-template-columns: 1fr; } }

    .save { font-size: 0.82rem; font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 999px; }
    .save[data-state='saved'] { color: var(--ok); background: var(--ok-bg); }
    .save[data-state='saving'] { color: var(--muted); background: var(--saving-bg); }
    .save[data-state='dirty'] { color: var(--warn); background: var(--warn-bg); }
  </style>

  <script is:inline>
    const saveEl = document.getElementById('save');
    const errEl = document.getElementById('err');
    let timer;
    function setState(s) {
      saveEl.dataset.state = s;
      saveEl.textContent = s === 'saving' ? 'Saving…' : s === 'dirty' ? 'Unsaved changes' : 'All changes saved';
    }
    function showErr(msg, invalid) {
      errEl.textContent = msg || '';
      errEl.hidden = !msg;
      const inv = invalid || [];
      document.querySelectorAll('input[data-pixel]').forEach((el) => {
        el.setAttribute('aria-invalid', inv.indexOf(el.dataset.pixel) !== -1 ? 'true' : 'false');
      });
      document.querySelectorAll('input[data-form-event]').forEach((el) => {
        el.setAttribute('aria-invalid', inv.indexOf(el.dataset.formEvent + ':event') !== -1 ? 'true' : 'false');
      });
      document.querySelectorAll('input[data-form-thanks]').forEach((el) => {
        el.setAttribute('aria-invalid', inv.indexOf(el.dataset.formThanks + ':thankYou') !== -1 ? 'true' : 'false');
      });
    }
    async function save() {
      setState('saving');
      const payload = { marketing_pixels: {}, form_conversions: {} };
      document.querySelectorAll('input[data-key]').forEach((el) => { payload[el.dataset.key] = el.value; });
      document.querySelectorAll('input[data-pixel]').forEach((el) => { payload.marketing_pixels[el.dataset.pixel] = el.value; });
      document.querySelectorAll('input[data-form-event]').forEach((el) => {
        const k = el.dataset.formEvent; (payload.form_conversions[k] = payload.form_conversions[k] || {}).event = el.value;
      });
      document.querySelectorAll('input[data-form-thanks]').forEach((el) => {
        const k = el.dataset.formThanks; (payload.form_conversions[k] = payload.form_conversions[k] || {}).thankYou = el.value;
      });
      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) { setState('saved'); showErr(''); }
        else { setState('dirty'); showErr(data.error || 'Could not save.', data.invalid); }
      } catch { setState('dirty'); showErr('Could not reach the server.'); }
    }
    document.querySelectorAll('input[data-key], input[data-pixel], input[data-form-event], input[data-form-thanks]').forEach((el) => {
      el.addEventListener('input', () => { setState('dirty'); clearTimeout(timer); timer = setTimeout(save, 700); });
    });
  </script>
</AdminLayout>
