---
// Fully composed from D1 blocks (editable from /admin), rendered by BlockRenderer
// — the hero+form, "How it Works" steps, trauma list, support & safety, CTA and
// logos are all data now. Draft shown only inside the authed admin preview.
export const prerender = false;

import ThemeLayout from '../layouts/ThemeLayout.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import { getBlocksForView } from '../lib/content';
import { isAuthed } from '../lib/admin';

const preview = Astro.url.searchParams.get('preview') === '1' && isAuthed(Astro.request);
const blocks = await getBlocksForView('become-a-foster-parent', 'main', preview);
---
<ThemeLayout name="become-a-foster-parent" title="Become a Foster Parent | Safe Harbours">
  {blocks.map((b, i) => <BlockRenderer block={b} index={i} />)}
</ThemeLayout>
