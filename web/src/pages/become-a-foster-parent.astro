---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import ContactForm from '../components/ContactForm.astro';

const title = 'Become a Foster Parent — Safe Harbours Ontario';
const description =
  'Becoming a foster parent is a rewarding journey that gives you the opportunity to provide a safe, stable, and loving home for children in need. See how the process works and take your first step with Safe Harbours.';

const steps = [
  {
    h: 'Interview / Initial Home Survey',
    p: 'We begin with an interview and home visit to get to know you and assess the environment where you’ll be fostering. This informal survey helps us understand your motivation for fostering and ensures your home meets the basic safety requirements.',
  },
  {
    h: 'Complete and Submit Application Documents',
    p: 'Next, you’ll complete the required application forms, which include background checks, references, and other important documentation. This step ensures that all necessary legal and safety requirements are met.',
  },
  {
    h: 'Home Study',
    p: 'A thorough evaluation of your household is conducted through the Home Study process. This involves interviews, assessments, and home inspections to ensure your family is fully prepared to foster. The study helps us match you with the right child based on your strengths and family dynamics.',
  },
  {
    h: 'Foster Parent Training',
    p: 'Once your application and home study are complete, you’ll participate in our comprehensive foster parent training. This training covers topics such as trauma-informed care, child development, and behaviour management to equip you with the skills and knowledge needed to provide exceptional care.',
  },
] as const;

const traumaAreas = [
  { h: 'Oppositional Defiance Disorder', p: 'Persistent disobedience, defiance, or hostility towards authority figures.' },
  { h: 'Conduct Disorder', p: 'A pattern of aggressive, disruptive, or anti-social behaviour.' },
  { h: 'Obsessive Compulsive Disorder', p: 'Repetitive behaviours or thoughts that can impact daily life.' },
  { h: 'Fetal Alcohol Spectrum Disorder', p: 'Developmental challenges due to prenatal alcohol exposure.' },
  { h: 'Post-Traumatic Stress Disorder', p: 'Emotional distress and trauma stemming from past experiences.' },
  { h: 'Drug & Alcohol Abuse', p: 'Struggles with substance use and addiction.' },
  { h: 'Encounters with Law Enforcement', p: 'Previous legal issues or encounters with the justice system.' },
  { h: 'Absence Without Leave (AWOL)', p: 'Running away or being absent without permission.' },
  { h: 'Stealing, Lying & Hoarding', p: 'Behaviours that may stem from past trauma or survival instincts.' },
] as const;

const supports = [
  { icon: 'users', h: 'Child and Youth Workers', p: 'Professionals who provide guidance and support for the youth.' },
  { icon: 'pulse', h: 'Funding for Immediate Psychological Services', p: 'Access to mental health resources as needed.' },
  { icon: 'handshake', h: 'Access to Community Support Programs', p: 'Including drug counselors, therapists, and more.' },
  { icon: 'cap', h: 'Educational Tutors', p: 'To support the youth’s academic growth.' },
] as const;
---
<BaseLayout title={title} description={description}>
  <PageHeader
    title="Become a Foster Parent"
    intro="Becoming a foster parent is a rewarding journey that gives you the opportunity to provide a safe, stable, and loving home for children in need. If you’ve ever felt the desire to make a difference in a child’s life, fostering may be the perfect way to do so."
  />

  <!-- APPLICATION -->
  <section class="pad cta" id="apply">
    <div class="wrap cta-grid">
      <div class="reveal">
        <span class="eyebrow">Take the first step</span>
        <h2>Interested In Becoming a Foster Parent?</h2>
        <p>Take the first step in applying to become a Foster Parent and let Safe Harbours help you all the way. We’re here to provide the best care to every child.</p>
        <p>Share your name, contact details, and a bit about your home. A member of our team will follow up to talk through the next steps and answer any questions you have.</p>
        <div class="ways">
          <div class="way"><span class="wic"><Icon name="check" /></span>No commitment — just a conversation</div>
          <div class="way"><span class="wic"><Icon name="shield" /></span>Your details are kept private</div>
        </div>
      </div>
      <ContactForm />
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="pad how" id="how">
    <div class="wrap">
      <div class="sec-head center">
        <span class="eyebrow">How it works</span>
        <h2>The path to becoming a foster parent</h2>
        <p>A clear, supported process — from your first conversation to your first placement.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal">
            <span class="step-n">{i + 1}</span>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </li>
        ))}
      </ol>
      <p class="center" style="margin-top:36px"><a class="btn btn-coral" href="#apply">Fill In The Form</a></p>
    </div>
  </section>

  <!-- POSSIBLE AREAS OF TRAUMA -->
  <section class="pad">
    <div class="wrap">
      <div class="sec-head center">
        <span class="eyebrow">What to expect</span>
        <h2>Possible Areas of Trauma</h2>
        <p>Children may arrive carrying the weight of past experiences. Understanding what they may be working through helps you support them — and you’re never doing it alone.</p>
      </div>
      <div class="points">
        {traumaAreas.map((t) => (
          <div class="point reveal">
            <h3>{t.h}</h3>
            <p>{t.p}</p>
          </div>
        ))}
      </div>
      <p class="center" style="margin-top:36px"><a class="btn btn-out" href="/contact-us">Learn More</a></p>
    </div>
  </section>

  <!-- SUPPORT & SAFETY -->
  <section class="pad bg-warm">
    <div class="wrap story">
      <div class="story-text reveal">
        <span class="eyebrow">Support &amp; safety</span>
        <h2>You’re backed by a team</h2>
        <p>The well-being of both the child and the foster family is a top priority at Safe Harbours. Within seven days of a child’s placement, a preliminary assessment will be conducted to identify any additional support needs.</p>
        <p>Our goal is to quickly integrate children into a routine — whether by enrolling them in school, connecting them with relevant special needs staff, and/or initiating support from community mental health agencies. Based on the assessment, additional support may include:</p>
      </div>
      <div class="story-media reveal">
        <Picture
          base="/images/become-support"
          alt="A child and foster parent supported by a care team"
          width={800}
          height={600}
          formats={['avif', 'webp']}
          widths={[640, 1024]}
          sizes="(min-width: 920px) 45vw, 100vw"
        />
      </div>
    </div>
    <div class="wrap" style="margin-top:8px">
      <div class="points">
        {supports.map((s) => (
          <div class="point reveal">
            <div class="ic"><Icon name={s.icon} /></div>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- IMMEDIATE THREATS -->
  <section class="pad">
    <div class="wrap prose reveal">
      <h2>For Immediate Threats</h2>
      <p>If a child’s behaviour threatens the safety of the home or community, we will tap into our resource network to determine next steps.</p>
      <p>In cases of an immediate threat, foster parents are advised to call the police, as maintaining a secure and safe home is essential, even if difficult decisions must be made.</p>
    </div>
  </section>

  <CtaBand
    title="Are you ready to make a difference?"
    text="Safe Harbours is here to guide you every step of the way. Contact us today to learn more about fostering and how you can get involved. Your journey to becoming a foster parent begins here."
  />
</BaseLayout>
