---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';

const title = 'Book an Appointment — Safe Harbours Ontario Foster Care';
const description =
  'Book a consultation with Safe Harbours. Tell us a little about you and our team will reach out to set up a time to talk about fostering in Ontario.';
---
<BaseLayout title={title} description={description}>
  <PageHeader
    title="Book an Appointment"
    intro="Ready to take the first step? Tell us a little about yourself and our team will reach out to arrange a time to talk — by phone or in person."
  />

  <section class="pad cta" id="book">
    <div class="wrap cta-grid">
      <div class="reveal">
        <h2>Let’s find a time to talk.</h2>
        <p>There’s no commitment in a first conversation. We’ll answer your questions about fostering, walk you through the process, and help you decide whether the next step is right for you.</p>
        <p>Prefer to talk right now? Give us a call and a real member of our team will pick up.</p>
        <div class="ways">
          <div class="way"><span class="wic"><Icon name="phone" /></span><a href={site.phoneHref}>{site.phone}</a></div>
          <div class="way"><span class="wic"><Icon name="mail" /></span><a href={site.emailHref}>{site.email}</a></div>
        </div>
        <p class="hero-cta" style="margin-top:24px">
          <a class="btn btn-coral" href={site.phoneHref}>Call {site.phone}</a>
          <a class="btn btn-out" href="/contact-us">Contact Us</a>
        </p>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
