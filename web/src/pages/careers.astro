---
// Careers page. SSR (reads the live jobs board from D1), so it's on-demand.
// We keep the mirrored marketing sections but RE-ORDER them so a job-seeker hits
// the openings first:  hero → Current Openings → "In College?" + "Why work…".
export const prerender = false;

import ThemeLayout from '../layouts/ThemeLayout.astro';
import JobsBoard from '../components/JobsBoard.astro';
import WhyWork from '../components/WhyWork.astro';
import blob from '../../_mirror/careers.main.html?raw';

// The mirrored markup order is hero → banner("In College?") → "Why work…"(.icon-items)
// → #job_list. We slice it into hero / banner / openings and re-emit:
//   hero → openings(JobsBoard) → "In College?" → <WhyWork/>.
// The reorder + the icon-card → <WhyWork/> swap ONLY fire when EVERY marker we depend
// on is present and correctly ordered. If the mirror is ever regenerated with different
// markup, we fall back to the original layout (blob as-is, the dead Indeed embed swapped
// for the board) — never a duplicated or missing "Why work" section.
const WIDGET = "<div class='sk-ww-indeed-jobs' data-embed-id='25480871'></div>";
const bannerStart = blob.indexOf('<div class="banner"');
const jobsStart = blob.indexOf('<div id="job_list"');
const widgetAt = blob.indexOf(WIDGET);

const marketing =
  bannerStart !== -1 && jobsStart !== -1 && jobsStart > bannerStart
    ? blob.slice(bannerStart, jobsStart)
    : '';
const iconStart = marketing.indexOf('<div class="icon-items"');
const canReorder = marketing !== '' && iconStart !== -1 && widgetAt > jobsStart;

let hero = '';
let banner = '';
let openBefore = '';
let openAfter = '';

if (canReorder) {
  hero = blob.slice(0, bannerStart);
  banner = marketing.slice(0, iconStart); // "In College?" only; drop the .icon-items triptych
  const openings = blob.slice(jobsStart); // #job_list wrapper → EOF
  const wi = openings.indexOf(WIDGET);
  openBefore = openings.slice(0, wi);
  openAfter = openings.slice(wi + WIDGET.length);
} else {
  // Safe fallback: original order, board swapped in at the widget, no <WhyWork/>.
  openBefore = widgetAt === -1 ? blob : blob.slice(0, widgetAt);
  openAfter = widgetAt === -1 ? '' : blob.slice(widgetAt + WIDGET.length);
}
---
<ThemeLayout name="careers" title="Careers | Safe Harbours">
  <Fragment set:html={hero} />
  <Fragment set:html={openBefore} />
  <JobsBoard />
  <Fragment set:html={openAfter} />
  <Fragment set:html={banner} />
  {canReorder && <WhyWork />}
</ThemeLayout>
