---
// Careers page. SSR (reads the live jobs board from D1), so it's on-demand.
// We keep the mirrored marketing sections but RE-ORDER them so a job-seeker hits
// the openings first:  hero → Current Openings → "In College?" + "Why work…".
export const prerender = false;

import ThemeLayout from '../layouts/ThemeLayout.astro';
import JobsBoard from '../components/JobsBoard.astro';
import blob from '../../_mirror/careers.main.html?raw';

// The mirrored markup order is hero → banner("In College?") → "Why work…" → #job_list.
// Slice it into hero / marketing / openings and re-emit openings before marketing.
const WIDGET = "<div class='sk-ww-indeed-jobs' data-embed-id='25480871'></div>";
const bannerStart = blob.indexOf('<div class="banner"'); // end of hero, start of marketing
const jobsStart = blob.indexOf('<div id="job_list"');    // start of openings (runs to EOF)
const reorder = bannerStart !== -1 && jobsStart !== -1 && jobsStart > bannerStart;

const hero = reorder ? blob.slice(0, bannerStart) : '';
const marketing = reorder ? blob.slice(bannerStart, jobsStart) : '';
const openings = reorder ? blob.slice(jobsStart) : blob; // fallback: whole blob keeps original order

// Inside the openings wrapper, swap the dead Indeed embed for the live board.
const wi = openings.indexOf(WIDGET);
const openBefore = wi === -1 ? openings : openings.slice(0, wi);
const openAfter = wi === -1 ? '' : openings.slice(wi + WIDGET.length);
---
<ThemeLayout name="careers" title="Careers | Safe Harbours">
  <Fragment set:html={hero} />
  <Fragment set:html={openBefore} />
  <JobsBoard />
  <Fragment set:html={openAfter} />
  <Fragment set:html={marketing} />
</ThemeLayout>
