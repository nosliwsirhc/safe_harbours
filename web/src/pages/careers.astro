---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Picture from '../components/Picture.astro';
import { site } from '../data/site';

const title = 'Careers — Join the Team at Safe Harbours';
const description =
  'At Safe Harbours, we are passionate about creating safe, nurturing homes for children in need. If you’re committed to making a positive impact in the lives of children and families, we invite you to join our team.';

const why = [
  {
    icon: 'heart',
    h: 'Meaningful Impact',
    p: 'Working with Safe Harbours means being part of a team that changes lives. Every day, you’ll have the chance to make a direct difference for children facing significant challenges.',
  },
  {
    icon: 'handshake',
    h: 'Collaborative Environment',
    p: 'Our team is built on trust, compassion, and support. We believe in working together to ensure the best outcomes for children, foster parents, and staff.',
  },
  {
    icon: 'cap',
    h: 'Growth and Development',
    p: 'Safe Harbours provides ongoing training and professional development opportunities, ensuring that every team member has the skills and knowledge to succeed in their role.',
  },
] as const;
---
<BaseLayout title={title} description={description}>
  <PageHeader
    title="Careers"
    intro="At Safe Harbours, we are passionate about creating safe, nurturing homes for children in need. If you’re committed to making a positive impact in the lives of children and families, we invite you to join our team."
  />

  <!-- JOIN OUR TEAM / OPENINGS -->
  <section class="pad" id="job_list">
    <div class="wrap prose reveal" style="text-align:center">
      <span class="eyebrow">Join Our Team</span>
      <h2>Current Opportunities</h2>
      <p>Open roles are posted here as they become available. If you’d like to be considered for current or future positions, reach out and tell us a little about yourself — we’d love to hear from you.</p>
      <p>
        <a class="btn btn-coral" href={site.emailHref}>Email Us Your Resume</a>
        <a class="btn btn-out" href="/contact-us">Contact Our Team</a>
      </p>
    </div>
  </section>

  <!-- WHY WORK HERE -->
  <section class="pad how">
    <div class="wrap">
      <div class="sec-head center">
        <span class="eyebrow">Why Safe Harbours</span>
        <h2>Why Work with Safe Harbours?</h2>
      </div>
      <div class="points">
        {why.map((w) => (
          <div class="point reveal">
            <div class="ic"><Icon name={w.icon} /></div>
            <h3>{w.h}</h3>
            <p>{w.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- IN COLLEGE -->
  <section class="pad bg-warm">
    <div class="wrap story">
      <div class="story-media reveal">
        <Picture
          base="/images/careers-college"
          alt="College students completing a child and youth care placement"
          width={800}
          height={600}
          formats={['avif', 'webp']}
          fallback="png"
          widths={[640, 1024]}
          sizes="(min-width: 920px) 45vw, 100vw"
        />
      </div>
      <div class="story-text reveal">
        <span class="eyebrow">Students welcome</span>
        <h2>In College?</h2>
        <p>We work with a number of colleges across Ontario to help students in the child and youth care field complete their diplomas. Let us know if you would like to do your student placement with us at Safe Harbours.</p>
        <p><a class="btn btn-coral" href="/contact-us">Learn More</a></p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Make a difference with us"
    text="Ready to do work that matters? Reach out and a member of our team will be in touch."
  />
</BaseLayout>
