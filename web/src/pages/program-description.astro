---
export const prerender = false;
import ThemeLayout from '../layouts/ThemeLayout.astro';
import BlockRenderer from '../components/BlockRenderer.astro';
import { getBlocksForView } from '../lib/content';
import { isAuthed } from '../lib/admin';
const preview = Astro.url.searchParams.get('preview') === '1' && isAuthed(Astro.request);
const blocks = await getBlocksForView('program-description', 'main', preview);
---
<ThemeLayout name="program-description" title="Program Description | Safe Harbours">
  {blocks.map((b, i) => <BlockRenderer block={b} index={i} />)}
</ThemeLayout>
