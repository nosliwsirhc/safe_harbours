---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';

const title = 'Resources — Safe Harbours Ontario Foster Care';
const description =
  'From essential training materials to expert advice on trauma-informed care, our resources help you provide the best possible care for the children in your home.';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={title} description={description}>
  <PageHeader
    title="Resources"
    intro="From essential training materials to expert advice on trauma-informed care, our resources are designed to help you provide the best possible care for the children in your home."
  />

  <section class="pad">
    <div class="wrap">
      <div class="news-grid">
        {posts.map((p) => (
          <a class="news-card reveal" href={`/resources/${p.id}`}>
            <span class="date">{fmt(p.data.date)}</span>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <span class="more">Read more <span class="arr"><Icon name="compass" size={16} /></span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Have a question we haven’t answered?"
    text="Reach out and a member of our team will get back to you within one business day. No pressure — just a conversation."
  />
</BaseLayout>
