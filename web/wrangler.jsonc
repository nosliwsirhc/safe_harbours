{
  // Read by @astrojs/cloudflare to add bindings to the deployed Worker. The adapter
  // still supplies main / assets / build settings; this only declares extras.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safe-harbours-web",
  "compatibility_date": "2026-04-15",
  // Don't expose the site on the *.workers.dev preview subdomain — production is
  // served via the www.safeharbours.ca Custom Domain only. Keeps a duplicate
  // copy of the site (and an admin surface) off a second hostname.
  "workers_dev": false,
  // The public job board (read-only here; written by the jobs-sync worker).
  // Accessed in SSR via `import { env } from 'cloudflare:workers'` → env.DB.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safeharbours-jobs",
      "database_id": "08193517-e7af-4b92-aee7-286865d9e3c0"
    }
  ],
  // Editor image uploads. Existing images stay as static /assets; new uploads go
  // here and are served via /media/<key>. Local dev fakes this automatically;
  // production needs: wrangler r2 bucket create safeharbours-media
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "safeharbours-media"
    }
  ]
}
